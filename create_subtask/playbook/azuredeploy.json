{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "metadata": {
        "title": "create_subtask",
        "description": "HTTP-triggered Logic App building block that creates one Jira subtask under an existing parent issue and returns a synchronous JSON response. The request requires parent_ticket_key and fields.summary/fields.description, with optional fields.priority and fields.assignee. The playbook resolves the parent project from Jira before creating the subtask to preserve project semantics.",
        "prerequisites": [
            "Key Vault secret '<JiraKeyVaultSecretName>' holding the Trackspace service account password.",
            "KeyVault API connection (this template creates it if absent)."
        ],
        "author": "create_subtask"
    },
    "parameters": {
        "PlaybookName": {
            "type": "string",
            "defaultValue": "create_subtask",
            "metadata": {
                "description": "Name of the Consumption Logic App. Pass it explicitly on deploy so redeploys update this instance."
            }
        },
        "Location": {
            "type": "string",
            "defaultValue": "westeurope",
            "metadata": {
                "description": "Azure region of the playbook and its Key Vault API connection."
            }
        },
        "KeyVaultName": {
            "type": "string",
            "defaultValue": "LSY-WEUR-ITCS-PRD-KV-02",
            "metadata": {
                "description": "Key Vault holding the Trackspace service-account password."
            }
        },
        "JIRAHOST": {
            "type": "string",
            "defaultValue": "https://trackspace.lhsystems.com",
            "metadata": {
                "description": "Trackspace base URL. Production is https://trackspace.lhsystems.com; use https://int-trackspace.lhsystems.com for INT."
            }
        },
        "JIRAUserName": {
            "type": "string",
            "defaultValue": "sentinelsvc",
            "metadata": {
                "description": "Trackspace service account username (Basic auth)."
            }
        },
        "JiraKeyVaultSecretName": {
            "type": "string",
            "defaultValue": "sentinelsvc",
            "metadata": {
                "description": "Key Vault secret name storing the Trackspace password."
            }
        },
        "DefaultSubtaskIssueTypeName": {
            "type": "string",
            "defaultValue": "Operation sub-task",
            "metadata": {
                "description": "Jira issue type name used for created subtasks when SubtaskDefaultsByProject has no issue_type for the parent's project."
            }
        },
        "DefaultSubtaskPriorityName": {
            "type": "string",
            "defaultValue": "4 - Normal",
            "metadata": {
                "description": "Fallback priority name when the request omits fields.priority."
            }
        },
        "DefaultSubtaskAssigneeName": {
            "type": "string",
            "defaultValue": "sentinelsvc",
            "metadata": {
                "description": "Fallback assignee login when the request omits fields.assignee. Empty omits assignee."
            }
        },
        "SubtaskDefaultsByProject": {
            "type": "object",
            "defaultValue": {
                "CLOPSSEC": {
                    "issue_type": "5",
                    "priority": "",
                    "assignee": ""
                }
            },
            "metadata": {
                "description": "Per parent-project overrides of the subtask defaults, keyed by Jira project key: issue_type (name, or numeric id sent as issuetype.id), priority, assignee. A key present here wins over the Default* parameter; an empty priority or assignee omits that field so Jira applies its own default. Projects not listed use the Default* parameters (OPSLSY: 'Operation sub-task')."
            }
        }
    },
    "variables": {
        "KeyVaultConnectionName": "[concat('keyvault-', parameters('PlaybookName'))]"
    },
    "resources": [
        {
            "type": "Microsoft.Web/connections",
            "apiVersion": "2016-06-01",
            "name": "[variables('KeyVaultConnectionName')]",
            "location": "[parameters('Location')]",
            "kind": "V1",
            "tags": {
                "CostCenter": "S60019",
                "Owner": "lsyh.sysops@lhsystems.com",
                "assessment-id": "1"
            },
            "properties": {
                "displayName": "[variables('KeyVaultConnectionName')]",
                "parameterValueType": "Alternative",
                "alternativeParameterValues": {
                    "vaultName": "[parameters('KeyVaultName')]"
                },
                "api": {
                    "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', parameters('Location'), '/managedApis/keyvault')]"
                }
            }
        },
        {
            "type": "Microsoft.Logic/workflows",
            "apiVersion": "2019-05-01",
            "name": "[parameters('PlaybookName')]",
            "location": "[parameters('Location')]",
            "tags": {
                "CostCenter": "S60019",
                "Owner": "lsyh.sysops@lhsystems.com",
                "assessment-id": "1"
            },
            "identity": {
                "type": "SystemAssigned"
            },
            "dependsOn": [
                "[resourceId('Microsoft.Web/connections', variables('KeyVaultConnectionName'))]"
            ],
            "properties": {
                "state": "Enabled",
                "definition": {
                    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
                    "contentVersion": "1.0.0.0",
                    "parameters": {
                        "$connections": {
                            "defaultValue": {},
                            "type": "Object"
                        },
                        "JIRAHOST": {
                            "defaultValue": "[parameters('JIRAHOST')]",
                            "type": "String"
                        },
                        "JIRAUserName": {
                            "defaultValue": "[parameters('JIRAUserName')]",
                            "type": "String"
                        },
                        "JiraKeyVaultSecretName": {
                            "defaultValue": "[parameters('JiraKeyVaultSecretName')]",
                            "type": "String"
                        },
                        "DefaultSubtaskIssueTypeName": {
                            "defaultValue": "[parameters('DefaultSubtaskIssueTypeName')]",
                            "type": "String"
                        },
                        "DefaultSubtaskPriorityName": {
                            "defaultValue": "[parameters('DefaultSubtaskPriorityName')]",
                            "type": "String"
                        },
                        "DefaultSubtaskAssigneeName": {
                            "defaultValue": "[parameters('DefaultSubtaskAssigneeName')]",
                            "type": "String"
                        },
                        "SubtaskDefaultsByProject": {
                            "defaultValue": "[parameters('SubtaskDefaultsByProject')]",
                            "type": "Object"
                        }
                    },
                    "triggers": {
                        "manual": {
                            "type": "Request",
                            "kind": "Http",
                            "inputs": {
                                "method": "POST",
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "parent_ticket_key": {
                                            "type": "string",
                                            "description": "Existing Jira parent key (for example OPSLSY-12345)."
                                        },
                                        "fields": {
                                            "type": "object",
                                            "properties": {
                                                "summary": {
                                                    "type": "string"
                                                },
                                                "description": {
                                                    "type": "string"
                                                },
                                                "priority": {
                                                    "type": "string"
                                                },
                                                "assignee": {
                                                    "type": "string"
                                                }
                                            },
                                            "required": [
                                                "summary",
                                                "description"
                                            ]
                                        }
                                    },
                                    "required": [
                                        "parent_ticket_key",
                                        "fields"
                                    ]
                                }
                            }
                        }
                    },
                    "actions": {
                        "Compose_Request": {
                            "runAfter": {},
                            "type": "Compose",
                            "inputs": {
                                "parent_ticket_key": "@{trim(string(coalesce(triggerBody()?['parent_ticket_key'], '')))}",
                                "summary": "@{trim(string(coalesce(triggerBody()?['fields']?['summary'], '')))}",
                                "description": "@{trim(string(coalesce(triggerBody()?['fields']?['description'], '')))}",
                                "priority": "@{trim(string(coalesce(triggerBody()?['fields']?['priority'], '')))}",
                                "assignee": "@{trim(string(coalesce(triggerBody()?['fields']?['assignee'], '')))}"
                            }
                        },
                        "Compose_Validation_Errors": {
                            "runAfter": {
                                "Compose_Request": [
                                    "Succeeded"
                                ]
                            },
                            "type": "Compose",
                            "inputs": "@union(if(empty(outputs('Compose_Request')?['parent_ticket_key']), array('parent_ticket_key is required.'), json('[]')), if(empty(outputs('Compose_Request')?['summary']), array('fields.summary is required.'), json('[]')), if(empty(outputs('Compose_Request')?['description']), array('fields.description is required.'), json('[]')))"
                        },
                        "Check_Request_Valid": {
                            "runAfter": {
                                "Compose_Validation_Errors": [
                                    "Succeeded"
                                ]
                            },
                            "type": "If",
                            "expression": {
                                "equals": [
                                    "@length(outputs('Compose_Validation_Errors'))",
                                    0
                                ]
                            },
                            "actions": {},
                            "else": {
                                "actions": {
                                    "Respond_400_invalid_request": {
                                        "runAfter": {},
                                        "type": "Response",
                                        "kind": "Http",
                                        "inputs": {
                                            "statusCode": 400,
                                            "headers": {
                                                "Content-Type": "application/json"
                                            },
                                            "body": {
                                                "status": "error",
                                                "ticket_key": null,
                                                "ticket_url": null,
                                                "parent_ticket_key": "@{outputs('Compose_Request')?['parent_ticket_key']}",
                                                "parent_project_key": null,
                                                "error": "@{join(outputs('Compose_Validation_Errors'), ' ')}"
                                            }
                                        }
                                    },
                                    "Terminate_invalid_request": {
                                        "runAfter": {
                                            "Respond_400_invalid_request": [
                                                "Succeeded"
                                            ]
                                        },
                                        "type": "Terminate",
                                        "inputs": {
                                            "runStatus": "Failed",
                                            "runError": {
                                                "code": "InvalidRequest",
                                                "message": "@{join(outputs('Compose_Validation_Errors'), ' ')}"
                                            }
                                        }
                                    }
                                }
                            }
                        },
                        "Get_Jira_password": {
                            "runAfter": {
                                "Check_Request_Valid": [
                                    "Succeeded"
                                ]
                            },
                            "type": "ApiConnection",
                            "inputs": {
                                "host": {
                                    "connection": {
                                        "name": "@parameters('$connections')['keyvault']['connectionId']"
                                    }
                                },
                                "method": "get",
                                "path": "/secrets/@{encodeURIComponent(parameters('JiraKeyVaultSecretName'))}/value"
                            },
                            "runtimeConfiguration": {
                                "secureData": {
                                    "properties": [
                                        "inputs",
                                        "outputs"
                                    ]
                                }
                            }
                        },
                        "Prime_Affinity_Cookie": {
                            "runAfter": {
                                "Get_Jira_password": [
                                    "Succeeded"
                                ]
                            },
                            "type": "Http",
                            "inputs": {
                                "uri": "@{parameters('JIRAHOST')}/rest/api/2/serverInfo",
                                "method": "GET",
                                "authentication": {
                                    "type": "Basic",
                                    "username": "@parameters('JIRAUserName')",
                                    "password": "@body('Get_Jira_password')?['value']"
                                }
                            },
                            "runtimeConfiguration": {
                                "secureData": {
                                    "properties": [
                                        "inputs",
                                        "outputs"
                                    ]
                                }
                            }
                        },
                        "Build_Cookie_Parts": {
                            "runAfter": {
                                "Prime_Affinity_Cookie": [
                                    "Succeeded",
                                    "Failed",
                                    "TimedOut"
                                ]
                            },
                            "type": "Select",
                            "inputs": {
                                "from": "@split(coalesce(outputs('Prime_Affinity_Cookie')?['headers']?['Set-Cookie'], ''), ',')",
                                "select": "@trim(first(split(item(), ';')))"
                            },
                            "runtimeConfiguration": {
                                "secureData": {
                                    "properties": [
                                        "inputs",
                                        "outputs"
                                    ]
                                }
                            }
                        },
                        "Get_Parent_Issue": {
                            "runAfter": {
                                "Build_Cookie_Parts": [
                                    "Succeeded"
                                ]
                            },
                            "type": "Http",
                            "inputs": {
                                "uri": "@{parameters('JIRAHOST')}/rest/api/2/issue/@{encodeURIComponent(outputs('Compose_Request')?['parent_ticket_key'])}",
                                "method": "GET",
                                "queries": {
                                    "fields": "project"
                                },
                                "headers": {
                                    "Accept": "application/json",
                                    "Cookie": "@{join(body('Build_Cookie_Parts'), '; ')}"
                                },
                                "authentication": {
                                    "type": "Basic",
                                    "username": "@parameters('JIRAUserName')",
                                    "password": "@body('Get_Jira_password')?['value']"
                                }
                            },
                            "runtimeConfiguration": {
                                "secureData": {
                                    "properties": [
                                        "inputs",
                                        "outputs"
                                    ]
                                }
                            }
                        },
                        "Parse_Parent_Issue": {
                            "runAfter": {
                                "Get_Parent_Issue": [
                                    "Succeeded"
                                ]
                            },
                            "type": "ParseJson",
                            "inputs": {
                                "content": "@body('Get_Parent_Issue')",
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "key": {
                                            "type": [
                                                "string",
                                                "null"
                                            ]
                                        },
                                        "fields": {
                                            "type": "object",
                                            "properties": {
                                                "project": {
                                                    "type": "object",
                                                    "properties": {
                                                        "key": {
                                                            "type": [
                                                                "string",
                                                                "null"
                                                            ]
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        },
                        "Compose_Resolved_Defaults": {
                            "runAfter": {
                                "Parse_Parent_Issue": [
                                    "Succeeded"
                                ]
                            },
                            "type": "Compose",
                            "inputs": {
                                "issue_type": "@{trim(string(if(contains(coalesce(parameters('SubtaskDefaultsByProject')?[string(body('Parse_Parent_Issue')?['fields']?['project']?['key'])], json('{}')), 'issue_type'), coalesce(parameters('SubtaskDefaultsByProject')?[string(body('Parse_Parent_Issue')?['fields']?['project']?['key'])], json('{}'))?['issue_type'], parameters('DefaultSubtaskIssueTypeName'))))}",
                                "priority": "@{if(empty(outputs('Compose_Request')?['priority']), trim(string(if(contains(coalesce(parameters('SubtaskDefaultsByProject')?[string(body('Parse_Parent_Issue')?['fields']?['project']?['key'])], json('{}')), 'priority'), coalesce(parameters('SubtaskDefaultsByProject')?[string(body('Parse_Parent_Issue')?['fields']?['project']?['key'])], json('{}'))?['priority'], parameters('DefaultSubtaskPriorityName')))), outputs('Compose_Request')?['priority'])}",
                                "assignee": "@{if(empty(outputs('Compose_Request')?['assignee']), trim(string(if(contains(coalesce(parameters('SubtaskDefaultsByProject')?[string(body('Parse_Parent_Issue')?['fields']?['project']?['key'])], json('{}')), 'assignee'), coalesce(parameters('SubtaskDefaultsByProject')?[string(body('Parse_Parent_Issue')?['fields']?['project']?['key'])], json('{}'))?['assignee'], parameters('DefaultSubtaskAssigneeName')))), outputs('Compose_Request')?['assignee'])}"
                            }
                        },
                        "Compose_Subtask_Fields": {
                            "runAfter": {
                                "Compose_Resolved_Defaults": [
                                    "Succeeded"
                                ]
                            },
                            "type": "Compose",
                            "inputs": "@union(addProperty(addProperty(addProperty(addProperty(addProperty(json('{}'), 'project', addProperty(json('{}'), 'key', body('Parse_Parent_Issue')?['fields']?['project']?['key'])), 'parent', addProperty(json('{}'), 'key', outputs('Compose_Request')?['parent_ticket_key'])), 'issuetype', addProperty(json('{}'), if(isInt(outputs('Compose_Resolved_Defaults')?['issue_type']), 'id', 'name'), outputs('Compose_Resolved_Defaults')?['issue_type'])), 'summary', outputs('Compose_Request')?['summary']), 'description', outputs('Compose_Request')?['description']), if(empty(outputs('Compose_Resolved_Defaults')?['priority']), json('{}'), addProperty(json('{}'), 'priority', addProperty(json('{}'), 'name', outputs('Compose_Resolved_Defaults')?['priority']))), if(empty(outputs('Compose_Resolved_Defaults')?['assignee']), json('{}'), addProperty(json('{}'), 'assignee', addProperty(json('{}'), 'name', outputs('Compose_Resolved_Defaults')?['assignee']))))"
                        },
                        "Compose_Subtask_Body": {
                            "runAfter": {
                                "Compose_Subtask_Fields": [
                                    "Succeeded"
                                ]
                            },
                            "type": "Compose",
                            "inputs": "@addProperty(json('{}'), 'fields', outputs('Compose_Subtask_Fields'))"
                        },
                        "Create_Subtask": {
                            "runAfter": {
                                "Compose_Subtask_Body": [
                                    "Succeeded"
                                ]
                            },
                            "type": "Http",
                            "inputs": {
                                "uri": "@{parameters('JIRAHOST')}/rest/api/2/issue",
                                "method": "POST",
                                "headers": {
                                    "Content-Type": "application/json",
                                    "Accept": "application/json",
                                    "Cookie": "@{join(body('Build_Cookie_Parts'), '; ')}"
                                },
                                "body": "@outputs('Compose_Subtask_Body')",
                                "authentication": {
                                    "type": "Basic",
                                    "username": "@parameters('JIRAUserName')",
                                    "password": "@body('Get_Jira_password')?['value']"
                                },
                                "retryPolicy": {
                                    "type": "none"
                                }
                            },
                            "runtimeConfiguration": {
                                "secureData": {
                                    "properties": [
                                        "inputs",
                                        "outputs"
                                    ]
                                }
                            }
                        },
                        "Parse_Create_Response": {
                            "runAfter": {
                                "Create_Subtask": [
                                    "Succeeded"
                                ]
                            },
                            "type": "ParseJson",
                            "inputs": {
                                "content": "@body('Create_Subtask')",
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "id": {
                                            "type": [
                                                "string",
                                                "null"
                                            ]
                                        },
                                        "key": {
                                            "type": [
                                                "string",
                                                "null"
                                            ]
                                        },
                                        "self": {
                                            "type": [
                                                "string",
                                                "null"
                                            ]
                                        }
                                    }
                                }
                            }
                        },
                        "Check_Create_Response_Valid": {
                            "runAfter": {
                                "Parse_Create_Response": [
                                    "Succeeded"
                                ]
                            },
                            "type": "If",
                            "expression": {
                                "not": {
                                    "equals": [
                                        "@trim(string(coalesce(body('Parse_Create_Response')?['key'], '')))",
                                        ""
                                    ]
                                }
                            },
                            "actions": {
                                "Respond_subtask_created": {
                                    "runAfter": {},
                                    "type": "Response",
                                    "kind": "Http",
                                    "inputs": {
                                        "statusCode": 200,
                                        "headers": {
                                            "Content-Type": "application/json"
                                        },
                                        "body": {
                                            "status": "ok",
                                            "ticket_key": "@{body('Parse_Create_Response')?['key']}",
                                            "ticket_url": "@{parameters('JIRAHOST')}/browse/@{body('Parse_Create_Response')?['key']}",
                                            "parent_ticket_key": "@{outputs('Compose_Request')?['parent_ticket_key']}",
                                            "parent_project_key": "@{body('Parse_Parent_Issue')?['fields']?['project']?['key']}",
                                            "error": null
                                        }
                                    }
                                }
                            },
                            "else": {
                                "actions": {
                                    "Respond_502_invalid_create_response": {
                                        "runAfter": {},
                                        "type": "Response",
                                        "kind": "Http",
                                        "inputs": {
                                            "statusCode": 502,
                                            "headers": {
                                                "Content-Type": "application/json"
                                            },
                                            "body": {
                                                "status": "error",
                                                "ticket_key": null,
                                                "ticket_url": null,
                                                "parent_ticket_key": "@{outputs('Compose_Request')?['parent_ticket_key']}",
                                                "parent_project_key": "@{body('Parse_Parent_Issue')?['fields']?['project']?['key']}",
                                                "error": "Jira create response did not contain a ticket key."
                                            }
                                        }
                                    },
                                    "Terminate_invalid_create_response": {
                                        "runAfter": {
                                            "Respond_502_invalid_create_response": [
                                                "Succeeded"
                                            ]
                                        },
                                        "type": "Terminate",
                                        "inputs": {
                                            "runStatus": "Failed",
                                            "runError": {
                                                "code": "InvalidCreateResponse",
                                                "message": "Jira create response did not contain a ticket key."
                                            }
                                        }
                                    }
                                }
                            }
                        },
                        "Handle_prepare_failure": {
                            "runAfter": {
                                "Get_Jira_password": [
                                    "Failed",
                                    "TimedOut"
                                ]
                            },
                            "type": "Scope",
                            "actions": {
                                "Respond_prepare_failed": {
                                    "runAfter": {},
                                    "type": "Response",
                                    "kind": "Http",
                                    "inputs": {
                                        "statusCode": 500,
                                        "headers": {
                                            "Content-Type": "application/json"
                                        },
                                        "body": {
                                            "status": "error",
                                            "ticket_key": null,
                                            "ticket_url": null,
                                            "parent_ticket_key": "@{outputs('Compose_Request')?['parent_ticket_key']}",
                                            "parent_project_key": null,
                                            "error": "Failed to retrieve Jira credentials from Key Vault."
                                        }
                                    }
                                },
                                "Terminate_prepare_failed": {
                                    "runAfter": {
                                        "Respond_prepare_failed": [
                                            "Succeeded"
                                        ]
                                    },
                                    "type": "Terminate",
                                    "inputs": {
                                        "runStatus": "Failed",
                                        "runError": {
                                            "code": "PrepareFailed",
                                            "message": "Failed to retrieve Jira credentials from Key Vault."
                                        }
                                    }
                                }
                            }
                        },
                        "Handle_parent_lookup_failure": {
                            "runAfter": {
                                "Get_Parent_Issue": [
                                    "Failed",
                                    "TimedOut"
                                ]
                            },
                            "type": "Scope",
                            "actions": {
                                "Compose_parent_lookup_error": {
                                    "runAfter": {},
                                    "type": "Compose",
                                    "inputs": "@{concat('Unable to read parent ticket (HTTP ', string(coalesce(outputs('Get_Parent_Issue')?['statusCode'], 502)), '): ', substring(string(coalesce(body('Get_Parent_Issue'), '')), 0, min(length(string(coalesce(body('Get_Parent_Issue'), ''))), 1000)))}"
                                },
                                "Respond_parent_lookup_failed": {
                                    "runAfter": {
                                        "Compose_parent_lookup_error": [
                                            "Succeeded"
                                        ]
                                    },
                                    "type": "Response",
                                    "kind": "Http",
                                    "inputs": {
                                        "statusCode": "@if(and(greaterOrEquals(coalesce(outputs('Get_Parent_Issue')?['statusCode'], 502), 400), less(coalesce(outputs('Get_Parent_Issue')?['statusCode'], 502), 600)), coalesce(outputs('Get_Parent_Issue')?['statusCode'], 502), 502)",
                                        "headers": {
                                            "Content-Type": "application/json"
                                        },
                                        "body": {
                                            "status": "error",
                                            "ticket_key": null,
                                            "ticket_url": null,
                                            "parent_ticket_key": "@{outputs('Compose_Request')?['parent_ticket_key']}",
                                            "parent_project_key": null,
                                            "error": "@{outputs('Compose_parent_lookup_error')}"
                                        }
                                    }
                                },
                                "Terminate_parent_lookup_failed": {
                                    "runAfter": {
                                        "Respond_parent_lookup_failed": [
                                            "Succeeded"
                                        ]
                                    },
                                    "type": "Terminate",
                                    "inputs": {
                                        "runStatus": "Failed",
                                        "runError": {
                                            "code": "ParentLookupFailed",
                                            "message": "@{outputs('Compose_parent_lookup_error')}"
                                        }
                                    }
                                }
                            }
                        },
                        "Handle_parent_parse_failure": {
                            "runAfter": {
                                "Parse_Parent_Issue": [
                                    "Failed",
                                    "TimedOut"
                                ]
                            },
                            "type": "Scope",
                            "actions": {
                                "Respond_parent_parse_failed": {
                                    "runAfter": {},
                                    "type": "Response",
                                    "kind": "Http",
                                    "inputs": {
                                        "statusCode": 502,
                                        "headers": {
                                            "Content-Type": "application/json"
                                        },
                                        "body": {
                                            "status": "error",
                                            "ticket_key": null,
                                            "ticket_url": null,
                                            "parent_ticket_key": "@{outputs('Compose_Request')?['parent_ticket_key']}",
                                            "parent_project_key": null,
                                            "error": "Parent lookup returned malformed Jira data."
                                        }
                                    }
                                },
                                "Terminate_parent_parse_failed": {
                                    "runAfter": {
                                        "Respond_parent_parse_failed": [
                                            "Succeeded"
                                        ]
                                    },
                                    "type": "Terminate",
                                    "inputs": {
                                        "runStatus": "Failed",
                                        "runError": {
                                            "code": "ParentParseFailed",
                                            "message": "Parent lookup returned malformed Jira data."
                                        }
                                    }
                                }
                            }
                        },
                        "Handle_create_failure": {
                            "runAfter": {
                                "Create_Subtask": [
                                    "Failed",
                                    "TimedOut"
                                ]
                            },
                            "type": "Scope",
                            "actions": {
                                "Compose_create_error": {
                                    "runAfter": {},
                                    "type": "Compose",
                                    "inputs": "@{concat('Jira did not create the subtask (HTTP ', string(coalesce(outputs('Create_Subtask')?['statusCode'], 502)), '): ', substring(string(coalesce(body('Create_Subtask'), '')), 0, min(length(string(coalesce(body('Create_Subtask'), ''))), 1000)))}"
                                },
                                "Respond_create_failed": {
                                    "runAfter": {
                                        "Compose_create_error": [
                                            "Succeeded"
                                        ]
                                    },
                                    "type": "Response",
                                    "kind": "Http",
                                    "inputs": {
                                        "statusCode": "@if(and(greaterOrEquals(coalesce(outputs('Create_Subtask')?['statusCode'], 502), 400), less(coalesce(outputs('Create_Subtask')?['statusCode'], 502), 600)), coalesce(outputs('Create_Subtask')?['statusCode'], 502), 502)",
                                        "headers": {
                                            "Content-Type": "application/json"
                                        },
                                        "body": {
                                            "status": "error",
                                            "ticket_key": null,
                                            "ticket_url": null,
                                            "parent_ticket_key": "@{outputs('Compose_Request')?['parent_ticket_key']}",
                                            "parent_project_key": "@{body('Parse_Parent_Issue')?['fields']?['project']?['key']}",
                                            "error": "@{outputs('Compose_create_error')}"
                                        }
                                    }
                                },
                                "Terminate_create_failed": {
                                    "runAfter": {
                                        "Respond_create_failed": [
                                            "Succeeded"
                                        ]
                                    },
                                    "type": "Terminate",
                                    "inputs": {
                                        "runStatus": "Failed",
                                        "runError": {
                                            "code": "JiraCreateFailed",
                                            "message": "@{outputs('Compose_create_error')}"
                                        }
                                    }
                                }
                            }
                        },
                        "Handle_create_parse_failure": {
                            "runAfter": {
                                "Parse_Create_Response": [
                                    "Failed",
                                    "TimedOut"
                                ]
                            },
                            "type": "Scope",
                            "actions": {
                                "Respond_create_parse_failed": {
                                    "runAfter": {},
                                    "type": "Response",
                                    "kind": "Http",
                                    "inputs": {
                                        "statusCode": 502,
                                        "headers": {
                                            "Content-Type": "application/json"
                                        },
                                        "body": {
                                            "status": "error",
                                            "ticket_key": null,
                                            "ticket_url": null,
                                            "parent_ticket_key": "@{outputs('Compose_Request')?['parent_ticket_key']}",
                                            "parent_project_key": "@{body('Parse_Parent_Issue')?['fields']?['project']?['key']}",
                                            "error": "Jira returned malformed subtask creation data."
                                        }
                                    }
                                },
                                "Terminate_create_parse_failed": {
                                    "runAfter": {
                                        "Respond_create_parse_failed": [
                                            "Succeeded"
                                        ]
                                    },
                                    "type": "Terminate",
                                    "inputs": {
                                        "runStatus": "Failed",
                                        "runError": {
                                            "code": "CreateParseFailed",
                                            "message": "Jira returned malformed subtask creation data."
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "outputs": {}
                },
                "parameters": {
                    "$connections": {
                        "value": {
                            "keyvault": {
                                "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', parameters('Location'), '/managedApis/keyvault')]",
                                "connectionId": "[resourceId('Microsoft.Web/connections', variables('KeyVaultConnectionName'))]",
                                "connectionName": "[variables('KeyVaultConnectionName')]",
                                "connectionProperties": {
                                    "authentication": {
                                        "type": "ManagedServiceIdentity"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    ],
    "outputs": {
        "logicAppName": {
            "type": "string",
            "value": "[parameters('PlaybookName')]"
        },
        "logicAppResourceId": {
            "type": "string",
            "value": "[resourceId('Microsoft.Logic/workflows', parameters('PlaybookName'))]"
        },
        "logicAppPrincipalId": {
            "type": "string",
            "value": "[reference(resourceId('Microsoft.Logic/workflows', parameters('PlaybookName')), '2019-05-01', 'Full').identity.principalId]"
        },
        "keyVaultName": {
            "type": "string",
            "value": "[parameters('KeyVaultName')]"
        }
    }
}
