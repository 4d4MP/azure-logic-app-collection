{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "PlaybookName": {
            "type": "string",
            "defaultValue": "blob-review",
            "metadata": {
                "description": "Name of the Consumption Logic App. Must be passed explicitly so a redeploy updates this playbook instead of standing up a parallel one."
            }
        },
        "FunctionAppName": {
            "type": "string",
            "defaultValue": "lsy-weur-itcs-prd-blobreview-func",
            "metadata": {
                "description": "Linux Consumption Function App hosting the AbuseIPDB enrichment shard. Globally unique."
            }
        },
        "FunctionStorageAccountName": {
            "type": "string",
            "defaultValue": "lsyweuritcsprdblobrev01",
            "metadata": {
                "description": "Runtime storage account for the Function App. Globally unique, <=24 lowercase alphanumerics. Holds no security data."
            }
        },
        "Location": {
            "type": "string",
            "defaultValue": "westeurope",
            "metadata": {
                "description": "Azure region of the playbook, the function app and the API connection."
            }
        },
        "KeyVaultName": {
            "type": "string",
            "defaultValue": "LSY-WEUR-ITCS-PRD-KV-02",
            "metadata": {
                "description": "Key Vault holding the Trackspace service-account password and the AbuseIPDB API key."
            }
        },
        "AbuseIPDBKeyVaultSecretName": {
            "type": "string",
            "defaultValue": "abuseipdb-api-key",
            "metadata": {
                "description": "Key Vault secret holding the AbuseIPDB API key. Read by the FUNCTION APP through a Key Vault reference app setting, not by the Logic App."
            }
        },
        "AppInsightsWorkspaceResourceId": {
            "type": "string",
            "defaultValue": "/subscriptions/f12b729d-7c1e-4407-bb9d-2e7ec4aa1d29/resourceGroups/lsy_weur_itcs_prd_oms_rg_001/providers/Microsoft.OperationalInsights/workspaces/LSY-PRD-OMS",
            "metadata": {
                "description": "Log Analytics workspace backing the function's Application Insights component."
            }
        },
        "JIRAHOST": {
            "type": "string",
            "defaultValue": "https://trackspace.lhsystems.com"
        },
        "JIRAUserName": {
            "type": "string",
            "defaultValue": "sentinelsvc"
        },
        "JiraKeyVaultSecretName": {
            "type": "string",
            "defaultValue": "sentinelsvc"
        },
        "JiraProjectKey": {
            "type": "string",
            "defaultValue": "CLOPSSEC"
        },
        "JiraIssueTypeName": {
            "type": "string",
            "defaultValue": "Task"
        },
        "TicketAssigneeName": {
            "type": "string",
            "defaultValue": "secops"
        },
        "TicketSummarySuffix": {
            "type": "string",
            "defaultValue": "IP review.",
            "metadata": {
                "description": "Appended to the blob file name to form the ticket title, e.g. 'index.html IP review.'"
            }
        },
        "StorageAccountName": {
            "type": "string",
            "defaultValue": "lsyweuritcsprdmspalo001",
            "metadata": {
                "description": "Storage account holding the Palo Alto EDL blob that is reviewed."
            }
        },
        "BlocklistContainer": {
            "type": "string",
            "defaultValue": "$web"
        },
        "BlocklistBlobPath": {
            "type": "string",
            "defaultValue": "index.html"
        },
        "EnrichmentParallelism": {
            "type": "int",
            "defaultValue": 50,
            "metadata": {
                "description": "Concurrent AbuseIPDB lookups. Global, not per batch: the orchestrator runs one activity at a time."
            }
        },
        "EnrichmentBatchSize": {
            "type": "int",
            "defaultValue": 1000,
            "metadata": {
                "description": "Addresses per activity invocation. Smaller batches checkpoint more often; larger ones cost less Durable queue latency."
            }
        },
        "AbuseIPDBMaxAgeInDays": {
            "type": "int",
            "defaultValue": 90,
            "metadata": {
                "description": "AbuseIPDB report window."
            }
        },
        "MaxFindings": {
            "type": "int",
            "defaultValue": 5000,
            "metadata": {
                "description": "Cap on the findings returned and written to the CSV. The reported count is never capped, so truncation is visible."
            }
        },
        "MaxLookupErrors": {
            "type": "int",
            "defaultValue": 0,
            "metadata": {
                "description": "Addresses that may fail to resolve against AbuseIPDB before the run is marked Failed. The ticket is raised first either way."
            }
        },
        "ReviewRules": {
            "type": "object",
            "defaultValue": {
                "internal": {
                    "enabled": true,
                    "extraCidrs": [],
                    "extraPatterns": []
                },
                "malformed": {
                    "enabled": true
                },
                "duplicate": {
                    "enabled": true
                },
                "whitelistedIsp": {
                    "enabled": true,
                    "maxScore": 80,
                    "isps": [
                        "akamai technologies",
                        "google",
                        "palo alto networks",
                        "the shadowserver foundation",
                        "censys",
                        "lufthansa",
                        "lido",
                        "sita aero"
                    ]
                }
            },
            "metadata": {
                "description": "The rule registry configuration. One key per rule; 'enabled' toggles it and the rest are that rule's parameters. Changing this needs no function redeploy."
            }
        }
    },
    "variables": {
        "KeyVaultConnectionName": "[concat('keyvault-', parameters('PlaybookName'))]",
        "HostingPlanName": "[concat(parameters('FunctionAppName'), '-plan')]"
    },
    "resources": [
        {
            "type": "Microsoft.Storage/storageAccounts",
            "apiVersion": "2023-05-01",
            "name": "[parameters('FunctionStorageAccountName')]",
            "location": "[parameters('Location')]",
            "sku": {
                "name": "Standard_LRS"
            },
            "kind": "StorageV2",
            "properties": {
                "minimumTlsVersion": "TLS1_2",
                "supportsHttpsTrafficOnly": true,
                "allowBlobPublicAccess": false
            }
        },
        {
            "type": "Microsoft.Insights/components",
            "apiVersion": "2020-02-02",
            "name": "[parameters('FunctionAppName')]",
            "location": "[parameters('Location')]",
            "kind": "web",
            "properties": {
                "Application_Type": "web",
                "WorkspaceResourceId": "[parameters('AppInsightsWorkspaceResourceId')]"
            }
        },
        {
            "type": "Microsoft.Web/serverfarms",
            "apiVersion": "2023-12-01",
            "name": "[variables('HostingPlanName')]",
            "location": "[parameters('Location')]",
            "kind": "functionapp",
            "sku": {
                "name": "Y1",
                "tier": "Dynamic"
            },
            "properties": {
                "reserved": true
            }
        },
        {
            "type": "Microsoft.Web/sites",
            "apiVersion": "2023-12-01",
            "name": "[parameters('FunctionAppName')]",
            "location": "[parameters('Location')]",
            "kind": "functionapp,linux",
            "dependsOn": [
                "[resourceId('Microsoft.Web/serverfarms', variables('HostingPlanName'))]",
                "[resourceId('Microsoft.Storage/storageAccounts', parameters('FunctionStorageAccountName'))]",
                "[resourceId('Microsoft.Insights/components', parameters('FunctionAppName'))]"
            ],
            "properties": {
                "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', variables('HostingPlanName'))]",
                "httpsOnly": true,
                "siteConfig": {
                    "linuxFxVersion": "Node|20",
                    "ftpsState": "Disabled",
                    "minTlsVersion": "1.2",
                    "appSettings": [
                        {
                            "name": "AzureWebJobsStorage",
                            "value": "[concat('DefaultEndpointsProtocol=https;AccountName=', parameters('FunctionStorageAccountName'), ';EndpointSuffix=', environment().suffixes.storage, ';AccountKey=', listKeys(resourceId('Microsoft.Storage/storageAccounts', parameters('FunctionStorageAccountName')), '2023-05-01').keys[0].value)]"
                        },
                        {
                            "name": "WEBSITE_CONTENTAZUREFILECONNECTIONSTRING",
                            "value": "[concat('DefaultEndpointsProtocol=https;AccountName=', parameters('FunctionStorageAccountName'), ';EndpointSuffix=', environment().suffixes.storage, ';AccountKey=', listKeys(resourceId('Microsoft.Storage/storageAccounts', parameters('FunctionStorageAccountName')), '2023-05-01').keys[0].value)]"
                        },
                        {
                            "name": "FUNCTIONS_EXTENSION_VERSION",
                            "value": "~4"
                        },
                        {
                            "name": "FUNCTIONS_WORKER_RUNTIME",
                            "value": "node"
                        },
                        {
                            "name": "WEBSITE_NODE_DEFAULT_VERSION",
                            "value": "~20"
                        },
                        {
                            "name": "APPLICATIONINSIGHTS_CONNECTION_STRING",
                            "value": "[reference(resourceId('Microsoft.Insights/components', parameters('FunctionAppName')), '2020-02-02').ConnectionString]"
                        },
                        {
                            "name": "WEBSITE_MAX_DYNAMIC_APPLICATION_SCALE_OUT",
                            "value": "1"
                        },
                        {
                            "name": "ABUSEIPDB_API_KEY",
                            "value": "[concat('@Microsoft.KeyVault(SecretUri=https://', toLower(parameters('KeyVaultName')), environment().suffixes.keyvaultDns, '/secrets/', parameters('AbuseIPDBKeyVaultSecretName'), '/)')]"
                        }
                    ]
                }
            },
            "identity": {
                "type": "SystemAssigned"
            }
        },
        {
            "type": "Microsoft.Web/connections",
            "apiVersion": "2016-06-01",
            "name": "[variables('KeyVaultConnectionName')]",
            "location": "[parameters('Location')]",
            "kind": "V1",
            "properties": {
                "displayName": "[variables('KeyVaultConnectionName')]",
                "customParameterValues": {},
                "parameterValueType": "Alternative",
                "alternativeParameterValues": {
                    "vaultName": "[parameters('KeyVaultName')]"
                },
                "api": {
                    "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', parameters('Location'), '/managedApis/keyvault')]"
                }
            }
        },
        {
            "type": "Microsoft.Logic/workflows",
            "apiVersion": "2019-05-01",
            "name": "[parameters('PlaybookName')]",
            "location": "[parameters('Location')]",
            "identity": {
                "type": "SystemAssigned"
            },
            "dependsOn": [
                "[resourceId('Microsoft.Web/connections', variables('KeyVaultConnectionName'))]",
                "[resourceId('Microsoft.Web/sites', parameters('FunctionAppName'))]"
            ],
            "properties": {
                "state": "Enabled",
                "definition": {
                    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
                    "contentVersion": "1.0.0.0",
                    "parameters": {
                        "$connections": {
                            "defaultValue": {},
                            "type": "Object"
                        },
                        "JIRAHOST": {
                            "defaultValue": "[parameters('JIRAHOST')]",
                            "type": "String"
                        },
                        "JIRAUserName": {
                            "defaultValue": "[parameters('JIRAUserName')]",
                            "type": "String"
                        },
                        "JiraKeyVaultSecretName": {
                            "defaultValue": "[parameters('JiraKeyVaultSecretName')]",
                            "type": "String"
                        },
                        "JiraProjectKey": {
                            "defaultValue": "[parameters('JiraProjectKey')]",
                            "type": "String"
                        },
                        "JiraIssueTypeName": {
                            "defaultValue": "[parameters('JiraIssueTypeName')]",
                            "type": "String"
                        },
                        "TicketAssigneeName": {
                            "defaultValue": "[parameters('TicketAssigneeName')]",
                            "type": "String"
                        },
                        "TicketSummarySuffix": {
                            "defaultValue": "[parameters('TicketSummarySuffix')]",
                            "type": "String"
                        },
                        "StorageAccountName": {
                            "defaultValue": "[parameters('StorageAccountName')]",
                            "type": "String"
                        },
                        "BlocklistContainer": {
                            "defaultValue": "[parameters('BlocklistContainer')]",
                            "type": "String"
                        },
                        "BlocklistBlobPath": {
                            "defaultValue": "[parameters('BlocklistBlobPath')]",
                            "type": "String"
                        },
                        "EnrichmentFunctionUrl": {
                            "defaultValue": "[concat('https://', reference(resourceId('Microsoft.Web/sites', parameters('FunctionAppName')), '2023-12-01').defaultHostName, '/api/start-review')]",
                            "type": "String"
                        },
                        "EnrichmentFunctionKey": {
                            "defaultValue": "[listKeys(resourceId('Microsoft.Web/sites/host', parameters('FunctionAppName'), 'default'), '2023-12-01').functionKeys.default]",
                            "type": "SecureString"
                        },
                        "EnrichmentParallelism": {
                            "defaultValue": "[parameters('EnrichmentParallelism')]",
                            "type": "Int"
                        },
                        "EnrichmentBatchSize": {
                            "defaultValue": "[parameters('EnrichmentBatchSize')]",
                            "type": "Int"
                        },
                        "AbuseIPDBMaxAgeInDays": {
                            "defaultValue": "[parameters('AbuseIPDBMaxAgeInDays')]",
                            "type": "Int"
                        },
                        "MaxFindings": {
                            "defaultValue": "[parameters('MaxFindings')]",
                            "type": "Int"
                        },
                        "MaxLookupErrors": {
                            "defaultValue": "[parameters('MaxLookupErrors')]",
                            "type": "Int"
                        },
                        "ReviewRules": {
                            "defaultValue": "[parameters('ReviewRules')]",
                            "type": "Object"
                        }
                    },
                    "triggers": {
                        "manual": {
                            "type": "Request",
                            "kind": "Http",
                            "inputs": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "blobPath": {
                                            "type": "string"
                                        },
                                        "container": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "actions": {
                        "Capture_run_start": {
                            "runAfter": {},
                            "type": "Compose",
                            "inputs": "@utcNow()"
                        },
                        "Resolve_blob_target": {
                            "runAfter": {
                                "Capture_run_start": [
                                    "Succeeded"
                                ]
                            },
                            "type": "Compose",
                            "inputs": {
                                "container": "@{if(empty(coalesce(triggerBody()?['container'], '')), parameters('BlocklistContainer'), triggerBody()['container'])}",
                                "path": "@{if(empty(coalesce(triggerBody()?['blobPath'], '')), parameters('BlocklistBlobPath'), triggerBody()['blobPath'])}",
                                "name": "@{last(split(if(empty(coalesce(triggerBody()?['blobPath'], '')), parameters('BlocklistBlobPath'), triggerBody()['blobPath']), '/'))}"
                            }
                        },
                        "Respond_accepted": {
                            "runAfter": {
                                "Resolve_blob_target": [
                                    "Succeeded"
                                ]
                            },
                            "type": "Response",
                            "kind": "Http",
                            "inputs": {
                                "statusCode": 202,
                                "headers": {
                                    "Content-Type": "application/json"
                                },
                                "body": {
                                    "status": "accepted",
                                    "runId": "@{workflow().run.name}",
                                    "container": "@{outputs('Resolve_blob_target')['container']}",
                                    "blobPath": "@{outputs('Resolve_blob_target')['path']}",
                                    "note": "The review runs asynchronously. Every run raises a CLOPSSEC ticket; see the run history for the outcome."
                                }
                            }
                        },
                        "Get_blocklist_blob": {
                            "runAfter": {
                                "Respond_accepted": [
                                    "Succeeded"
                                ]
                            },
                            "type": "Http",
                            "inputs": {
                                "uri": "https://@{parameters('StorageAccountName')}.blob.core.windows.net/@{outputs('Resolve_blob_target')['container']}/@{outputs('Resolve_blob_target')['path']}",
                                "method": "GET",
                                "headers": {
                                    "x-ms-version": "2021-12-02"
                                },
                                "authentication": {
                                    "type": "ManagedServiceIdentity",
                                    "audience": "https://storage.azure.com/"
                                }
                            }
                        },
                        "Check_blocklist_not_empty": {
                            "runAfter": {
                                "Get_blocklist_blob": [
                                    "Succeeded"
                                ]
                            },
                            "type": "If",
                            "expression": {
                                "greater": [
                                    "@length(trim(string(body('Get_blocklist_blob'))))",
                                    0
                                ]
                            },
                            "actions": {
                                "Run_review": {
                                    "runAfter": {},
                                    "type": "Http",
                                    "inputs": {
                                        "uri": "@parameters('EnrichmentFunctionUrl')",
                                        "method": "POST",
                                        "headers": {
                                            "Content-Type": "application/json",
                                            "x-functions-key": "@parameters('EnrichmentFunctionKey')"
                                        },
                                        "body": {
                                            "runId": "@{workflow().run.name}",
                                            "container": "@{outputs('Resolve_blob_target')['container']}",
                                            "blobPath": "@{outputs('Resolve_blob_target')['path']}",
                                            "blobText": "@{string(body('Get_blocklist_blob'))}",
                                            "rules": "@parameters('ReviewRules')",
                                            "parallelism": "@parameters('EnrichmentParallelism')",
                                            "batchSize": "@parameters('EnrichmentBatchSize')",
                                            "maxAgeInDays": "@parameters('AbuseIPDBMaxAgeInDays')",
                                            "maxFindings": "@parameters('MaxFindings')"
                                        },
                                        "retryPolicy": {
                                            "type": "none"
                                        }
                                    },
                                    "limit": {
                                        "timeout": "PT30M"
                                    },
                                    "runtimeConfiguration": {
                                        "secureData": {
                                            "properties": [
                                                "inputs"
                                            ]
                                        }
                                    }
                                },
                                "Capture_run_end": {
                                    "runAfter": {
                                        "Run_review": [
                                            "Succeeded"
                                        ]
                                    },
                                    "type": "Compose",
                                    "inputs": "@utcNow()"
                                },
                                "Compose_review": {
                                    "runAfter": {
                                        "Capture_run_end": [
                                            "Succeeded"
                                        ]
                                    },
                                    "type": "Compose",
                                    "inputs": "@body('Run_review')?['output']"
                                },
                                "Guard_review_completed": {
                                    "runAfter": {
                                        "Compose_review": [
                                            "Succeeded"
                                        ]
                                    },
                                    "type": "If",
                                    "expression": {
                                        "not": {
                                            "equals": [
                                                "@body('Run_review')?['runtimeStatus']",
                                                "Completed"
                                            ]
                                        }
                                    },
                                    "actions": {
                                        "Terminate_review_incomplete": {
                                            "runAfter": {},
                                            "type": "Terminate",
                                            "inputs": {
                                                "runStatus": "Failed",
                                                "runError": {
                                                    "code": "ReviewNotCompleted",
                                                    "message": "@{concat('The blob-review orchestration ended as ', coalesce(body('Run_review')?['runtimeStatus'], 'unknown'), ' rather than Completed, so its result cannot be trusted. No ticket was raised.')}"
                                                }
                                            }
                                        }
                                    },
                                    "else": {
                                        "actions": {}
                                    }
                                },
                                "Get_Jira_password": {
                                    "runAfter": {
                                        "Guard_review_completed": [
                                            "Succeeded"
                                        ]
                                    },
                                    "type": "ApiConnection",
                                    "inputs": {
                                        "host": {
                                            "connection": {
                                                "name": "@parameters('$connections')['keyvault']['connectionId']"
                                            }
                                        },
                                        "method": "get",
                                        "path": "/secrets/@{encodeURIComponent(parameters('JiraKeyVaultSecretName'))}/value"
                                    },
                                    "runtimeConfiguration": {
                                        "secureData": {
                                            "properties": [
                                                "inputs",
                                                "outputs"
                                            ]
                                        }
                                    }
                                },
                                "Jira_health_check": {
                                    "runAfter": {
                                        "Get_Jira_password": [
                                            "Succeeded"
                                        ]
                                    },
                                    "type": "Http",
                                    "inputs": {
                                        "uri": "@{parameters('JIRAHOST')}/rest/api/2/myself",
                                        "method": "GET",
                                        "authentication": {
                                            "type": "Basic",
                                            "username": "@parameters('JIRAUserName')",
                                            "password": "@body('Get_Jira_password')?['value']"
                                        }
                                    },
                                    "runtimeConfiguration": {
                                        "secureData": {
                                            "properties": [
                                                "inputs"
                                            ]
                                        }
                                    }
                                },
                                "Create_CLOPSSEC_ticket": {
                                    "runAfter": {
                                        "Jira_health_check": [
                                            "Succeeded"
                                        ]
                                    },
                                    "type": "Http",
                                    "inputs": {
                                        "uri": "@{parameters('JIRAHOST')}/rest/api/2/issue",
                                        "method": "POST",
                                        "headers": {
                                            "Content-Type": "application/json"
                                        },
                                        "body": {
                                            "fields": {
                                                "project": {
                                                    "key": "@{parameters('JiraProjectKey')}"
                                                },
                                                "issuetype": {
                                                    "name": "@{parameters('JiraIssueTypeName')}"
                                                },
                                                "summary": "@{outputs('Resolve_blob_target')['name']} @{parameters('TicketSummarySuffix')}",
                                                "description": "Run ID: @{workflow().run.name}\nStart: @{convertTimeZone(outputs('Capture_run_start'), 'UTC', 'Central European Standard Time', 'yyyy-MM-dd HH:mm')}\nEnd: @{convertTimeZone(outputs('Capture_run_end'), 'UTC', 'Central European Standard Time', 'yyyy-MM-dd HH:mm')}\nFlagged IPs: @{coalesce(outputs('Compose_review')?['summary']?['flagged'], 0)}\n\nCoverage: @{parameters('StorageAccountName')}/@{outputs('Resolve_blob_target')['container']}/@{outputs('Resolve_blob_target')['path']} - @{coalesce(outputs('Compose_review')?['summary']?['entries'], 0)} entr(ies) read, @{coalesce(outputs('Compose_review')?['summary']?['flaggedBeforeEnrichment'], 0)} flagged before enrichment (internal, malformed or a duplicate copy - never sent to AbuseIPDB), @{coalesce(outputs('Compose_review')?['summary']?['checked'], 0)} checked against AbuseIPDB, @{coalesce(outputs('Compose_review')?['summary']?['skippedCidrs'], 0)} public CIDR range(s) not checked, @{coalesce(outputs('Compose_review')?['summary']?['errors'], 0)} lookup error(s).\nRules applied:\n@{join(coalesce(outputs('Compose_review')?['summary']?['rulesApplied'], json('[]')), decodeUriComponent('%0A'))}\n\nRaised automatically by the @{workflow().name} Logic App. Findings, with the blob line each one sits on, are in the attachment."
                                            }
                                        },
                                        "authentication": {
                                            "type": "Basic",
                                            "username": "@parameters('JIRAUserName')",
                                            "password": "@body('Get_Jira_password')?['value']"
                                        }
                                    },
                                    "runtimeConfiguration": {
                                        "secureData": {
                                            "properties": [
                                                "inputs"
                                            ]
                                        }
                                    }
                                },
                                "Parse_ticket_response": {
                                    "runAfter": {
                                        "Create_CLOPSSEC_ticket": [
                                            "Succeeded"
                                        ]
                                    },
                                    "type": "ParseJson",
                                    "inputs": {
                                        "content": "@body('Create_CLOPSSEC_ticket')",
                                        "schema": {
                                            "type": "object",
                                            "properties": {
                                                "id": {
                                                    "type": "string"
                                                },
                                                "key": {
                                                    "type": "string"
                                                },
                                                "self": {
                                                    "type": "string"
                                                }
                                            }
                                        }
                                    }
                                },
                                "Findings_attachment_gate": {
                                    "runAfter": {
                                        "Parse_ticket_response": [
                                            "Succeeded"
                                        ]
                                    },
                                    "type": "If",
                                    "expression": {
                                        "greater": [
                                            "@coalesce(outputs('Compose_review')?['summary']?['flagged'], 0)",
                                            0
                                        ]
                                    },
                                    "actions": {
                                        "Attach_findings_CSV": {
                                            "runAfter": {},
                                            "type": "Http",
                                            "inputs": {
                                                "uri": "@{parameters('JIRAHOST')}/rest/api/2/issue/@{body('Parse_ticket_response')?['key']}/attachments",
                                                "method": "POST",
                                                "headers": {
                                                    "X-Atlassian-Token": "no-check"
                                                },
                                                "body": {
                                                    "$content-type": "multipart/form-data",
                                                    "$multipart": [
                                                        {
                                                            "headers": {
                                                                "Content-Disposition": "form-data; name=\"file\"; filename=\"@{outputs('Resolve_blob_target')['name']}-ip-review-@{formatDateTime(outputs('Capture_run_end'), 'yyyyMMdd-HHmmss')}.csv\"",
                                                                "Content-Type": "text/csv"
                                                            },
                                                            "body": "@outputs('Compose_review')?['csv']"
                                                        }
                                                    ]
                                                },
                                                "authentication": {
                                                    "type": "Basic",
                                                    "username": "@parameters('JIRAUserName')",
                                                    "password": "@body('Get_Jira_password')?['value']"
                                                }
                                            },
                                            "runtimeConfiguration": {
                                                "secureData": {
                                                    "properties": [
                                                        "inputs"
                                                    ]
                                                }
                                            }
                                        }
                                    },
                                    "else": {
                                        "actions": {}
                                    }
                                },
                                "Assign_ticket": {
                                    "runAfter": {
                                        "Findings_attachment_gate": [
                                            "Succeeded"
                                        ]
                                    },
                                    "type": "Http",
                                    "inputs": {
                                        "uri": "@{parameters('JIRAHOST')}/rest/api/2/issue/@{body('Parse_ticket_response')?['key']}/assignee",
                                        "method": "PUT",
                                        "headers": {
                                            "Content-Type": "application/json"
                                        },
                                        "body": {
                                            "name": "@{parameters('TicketAssigneeName')}"
                                        },
                                        "authentication": {
                                            "type": "Basic",
                                            "username": "@parameters('JIRAUserName')",
                                            "password": "@body('Get_Jira_password')?['value']"
                                        }
                                    },
                                    "runtimeConfiguration": {
                                        "secureData": {
                                            "properties": [
                                                "inputs"
                                            ]
                                        }
                                    }
                                },
                                "Guard_lookup_errors": {
                                    "runAfter": {
                                        "Assign_ticket": [
                                            "Succeeded",
                                            "Failed",
                                            "TimedOut"
                                        ]
                                    },
                                    "type": "If",
                                    "expression": {
                                        "greater": [
                                            "@coalesce(outputs('Compose_review')?['summary']?['errors'], 0)",
                                            "@parameters('MaxLookupErrors')"
                                        ]
                                    },
                                    "actions": {
                                        "Terminate_incomplete_scan": {
                                            "runAfter": {},
                                            "type": "Terminate",
                                            "inputs": {
                                                "runStatus": "Failed",
                                                "runError": {
                                                    "code": "IncompleteScan",
                                                    "message": "@{concat(string(coalesce(outputs('Compose_review')?['summary']?['errors'], 0)), ' address(es) could not be resolved against AbuseIPDB, above the MaxLookupErrors threshold of ', string(parameters('MaxLookupErrors')), '. Ticket ', coalesce(body('Parse_ticket_response')?['key'], 'unknown'), ' was raised with what the run did find, but the blocklist was not fully reviewed.')}"
                                                }
                                            }
                                        }
                                    },
                                    "else": {
                                        "actions": {
                                            "Compose_run_result": {
                                                "runAfter": {},
                                                "type": "Compose",
                                                "inputs": {
                                                    "ticket": "@{parameters('JIRAHOST')}/browse/@{body('Parse_ticket_response')?['key']}",
                                                    "assigned": "@equals(coalesce(outputs('Assign_ticket')?['statusCode'], 0), 204)",
                                                    "attached": "@greater(coalesce(outputs('Compose_review')?['summary']?['flagged'], 0), 0)",
                                                    "summary": "@outputs('Compose_review')?['summary']",
                                                    "skipped": "@outputs('Compose_review')?['skipped']",
                                                    "lookupErrors": "@outputs('Compose_review')?['errorDetail']",
                                                    "blob": {
                                                        "account": "@{parameters('StorageAccountName')}",
                                                        "container": "@{outputs('Resolve_blob_target')['container']}",
                                                        "path": "@{outputs('Resolve_blob_target')['path']}",
                                                        "etag": "@{coalesce(outputs('Get_blocklist_blob')?['headers']?['ETag'], '')}",
                                                        "lastModified": "@{coalesce(outputs('Get_blocklist_blob')?['headers']?['Last-Modified'], '')}"
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            },
                            "else": {
                                "actions": {
                                    "Terminate_empty_blocklist": {
                                        "runAfter": {},
                                        "type": "Terminate",
                                        "inputs": {
                                            "runStatus": "Failed",
                                            "runError": {
                                                "code": "EmptyBlocklist",
                                                "message": "@{concat('Blob ', parameters('StorageAccountName'), '/', outputs('Resolve_blob_target')['container'], '/', outputs('Resolve_blob_target')['path'], ' came back empty. Treated as a fetch or format problem, not an all-clear, so no ticket was raised.')}"
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "outputs": {}
                },
                "parameters": {
                    "$connections": {
                        "value": {
                            "keyvault": {
                                "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', parameters('Location'), '/managedApis/keyvault')]",
                                "connectionId": "[resourceId('Microsoft.Web/connections', variables('KeyVaultConnectionName'))]",
                                "connectionName": "[variables('KeyVaultConnectionName')]",
                                "connectionProperties": {
                                    "authentication": {
                                        "type": "ManagedServiceIdentity"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    ],
    "outputs": {
        "logicAppName": {
            "type": "string",
            "value": "[parameters('PlaybookName')]"
        },
        "logicAppPrincipalId": {
            "type": "string",
            "value": "[reference(resourceId('Microsoft.Logic/workflows', parameters('PlaybookName')), '2019-05-01', 'Full').identity.principalId]"
        },
        "functionAppName": {
            "type": "string",
            "value": "[parameters('FunctionAppName')]"
        },
        "keyVaultName": {
            "type": "string",
            "value": "[parameters('KeyVaultName')]"
        },
        "blocklistStorageAccountName": {
            "type": "string",
            "value": "[parameters('StorageAccountName')]"
        },
        "functionAppPrincipalId": {
            "type": "string",
            "value": "[reference(resourceId('Microsoft.Web/sites', parameters('FunctionAppName')), '2023-12-01', 'Full').identity.principalId]"
        }
    }
}
