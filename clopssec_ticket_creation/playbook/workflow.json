{
    "definition": {
        "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
        "contentVersion": "1.0.0.0",
        "parameters": {
            "$connections": {
                "defaultValue": {},
                "type": "Object"
            },
            "JIRAHOST": {
                "defaultValue": "https://trackspace.lhsystems.com",
                "type": "String"
            },
            "JIRAUserName": {
                "defaultValue": "sentinelsvc",
                "type": "String"
            },
            "JiraKeyVaultSecretName": {
                "defaultValue": "sentinelsvc",
                "type": "String"
            },
            "JiraProjectKey": {
                "defaultValue": "CLOPSSEC",
                "type": "String"
            },
            "AllowedIssueTypes": {
                "defaultValue": [
                    "Task",
                    "Problem",
                    "Incident"
                ],
                "type": "Array"
            },
            "MandatoryFieldsByType": {
                "defaultValue": {
                    "Task": [
                        "summary",
                        "description"
                    ],
                    "Problem": [
                        "summary",
                        "subscription"
                    ],
                    "Incident": [
                        "summary",
                        "description"
                    ]
                },
                "type": "Object"
            },
            "DefaultPriorityByType": {
                "defaultValue": {
                    "Task": "3 - Medium",
                    "Problem": "3 - Medium",
                    "Incident": "1 - Critical"
                },
                "type": "Object"
            },
            "DefaultAssigneeName": {
                "defaultValue": "-1",
                "type": "String"
            },
            "DefaultSecurityLevelName": {
                "defaultValue": "",
                "type": "String"
            },
            "DefaultIssueLinkTypeName": {
                "defaultValue": "",
                "type": "String"
            },
            "JiraCustomFields": {
                "defaultValue": [
                    {
                        "key": "category",
                        "name": "Category",
                        "id": "",
                        "kind": "select"
                    },
                    {
                        "key": "reason_for_investigation",
                        "name": "Reason for investigation",
                        "id": "",
                        "kind": "select"
                    },
                    {
                        "key": "subscription",
                        "name": "Subscription",
                        "id": "",
                        "kind": "insight"
                    },
                    {
                        "key": "affected_item",
                        "name": "Affected item",
                        "id": "",
                        "kind": "insight"
                    },
                    {
                        "key": "provider",
                        "name": "Provider",
                        "id": "",
                        "kind": "insight"
                    },
                    {
                        "key": "external_issue_id",
                        "name": "External issue ID",
                        "id": "",
                        "kind": "text"
                    },
                    {
                        "key": "customer_reference",
                        "name": "Customer reference",
                        "id": "",
                        "kind": "text"
                    },
                    {
                        "key": "dod",
                        "name": "DoD",
                        "id": "",
                        "kind": "checklist"
                    }
                ],
                "type": "Array"
            }
        },
        "triggers": {
            "manual": {
                "type": "Request",
                "kind": "Http",
                "inputs": {
                    "method": "POST",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "issue_type": {
                                "type": "string",
                                "description": "Task | Problem | Incident"
                            },
                            "fields": {
                                "type": "object",
                                "properties": {
                                    "summary": {
                                        "type": "string"
                                    },
                                    "description": {
                                        "type": "string"
                                    },
                                    "priority": {
                                        "type": "string",
                                        "description": "Jira priority name (e.g. '3 - Medium') or numeric id (e.g. '10114'). Omit for the per-type default."
                                    },
                                    "security_level": {
                                        "type": "string"
                                    },
                                    "reporter": {
                                        "type": "string"
                                    },
                                    "assignee": {
                                        "type": "string"
                                    },
                                    "components": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        }
                                    },
                                    "labels": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        }
                                    },
                                    "due_date": {
                                        "type": "string"
                                    },
                                    "category": {
                                        "type": "string"
                                    },
                                    "reason_for_investigation": {
                                        "type": "string"
                                    },
                                    "subscription": {
                                        "type": "string"
                                    },
                                    "affected_item": {
                                        "type": "string"
                                    },
                                    "provider": {
                                        "type": "string"
                                    },
                                    "external_issue_id": {
                                        "type": "string"
                                    },
                                    "customer_reference": {
                                        "type": "string"
                                    },
                                    "dod": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        }
                                    },
                                    "linked_issues": {
                                        "type": "object",
                                        "properties": {
                                            "type": {
                                                "type": "string"
                                            },
                                            "direction": {
                                                "type": "string"
                                            },
                                            "keys": {
                                                "type": "array",
                                                "items": {
                                                    "type": "string"
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "actions": {
            "Initialize_Ticket_Key": {
                "runAfter": {},
                "type": "InitializeVariable",
                "inputs": {
                    "variables": [
                        {
                            "name": "Ticket_Key",
                            "type": "string",
                            "value": ""
                        }
                    ]
                }
            },
            "Initialize_Custom_Fields": {
                "runAfter": {
                    "Initialize_Ticket_Key": [
                        "Succeeded"
                    ]
                },
                "type": "InitializeVariable",
                "inputs": {
                    "variables": [
                        {
                            "name": "Custom_Fields",
                            "type": "object",
                            "value": {}
                        }
                    ]
                }
            },
            "Initialize_Unresolved_Fields": {
                "runAfter": {
                    "Initialize_Custom_Fields": [
                        "Succeeded"
                    ]
                },
                "type": "InitializeVariable",
                "inputs": {
                    "variables": [
                        {
                            "name": "Unresolved_Fields",
                            "type": "array",
                            "value": []
                        }
                    ]
                }
            },
            "Prepare": {
                "runAfter": {
                    "Initialize_Unresolved_Fields": [
                        "Succeeded"
                    ]
                },
                "type": "Scope",
                "actions": {
                    "Filter_allowed_issue_types": {
                        "runAfter": {},
                        "type": "Query",
                        "inputs": {
                            "from": "@parameters('AllowedIssueTypes')",
                            "where": "@equals(toLower(string(item())), toLower(trim(string(coalesce(triggerBody()?['issue_type'], '')))))"
                        }
                    },
                    "Compose_issue_type": {
                        "runAfter": {
                            "Filter_allowed_issue_types": [
                                "Succeeded"
                            ]
                        },
                        "type": "Compose",
                        "inputs": "@{join(body('Filter_allowed_issue_types'), '')}"
                    },
                    "Filter_missing_mandatory_fields": {
                        "runAfter": {
                            "Compose_issue_type": [
                                "Succeeded"
                            ]
                        },
                        "type": "Query",
                        "inputs": {
                            "from": "@coalesce(parameters('MandatoryFieldsByType')?[if(empty(outputs('Compose_issue_type')), '-', outputs('Compose_issue_type'))], json('[]'))",
                            "where": "@empty(trim(string(coalesce(triggerBody()?['fields']?[item()], ''))))"
                        }
                    },
                    "Compose_normalized_lists": {
                        "runAfter": {
                            "Compose_issue_type": [
                                "Succeeded"
                            ]
                        },
                        "type": "Compose",
                        "inputs": {
                            "components": "@if(empty(coalesce(triggerBody()?['fields']?['components'], '')), json('[]'), if(startsWith(string(coalesce(triggerBody()?['fields']?['components'], '')), '['), coalesce(triggerBody()?['fields']?['components'], json('[]')), array(coalesce(triggerBody()?['fields']?['components'], ''))))",
                            "labels": "@if(empty(coalesce(triggerBody()?['fields']?['labels'], '')), json('[]'), if(startsWith(string(coalesce(triggerBody()?['fields']?['labels'], '')), '['), coalesce(triggerBody()?['fields']?['labels'], json('[]')), array(coalesce(triggerBody()?['fields']?['labels'], ''))))",
                            "link_keys": "@if(empty(coalesce(triggerBody()?['fields']?['linked_issues']?['keys'], '')), json('[]'), if(startsWith(string(coalesce(triggerBody()?['fields']?['linked_issues']?['keys'], '')), '['), coalesce(triggerBody()?['fields']?['linked_issues']?['keys'], json('[]')), array(coalesce(triggerBody()?['fields']?['linked_issues']?['keys'], ''))))"
                        }
                    },
                    "Compose_issue_links": {
                        "runAfter": {
                            "Compose_normalized_lists": [
                                "Succeeded"
                            ]
                        },
                        "type": "Compose",
                        "inputs": {
                            "type": "@{if(empty(trim(string(coalesce(triggerBody()?['fields']?['linked_issues']?['type'], '')))), parameters('DefaultIssueLinkTypeName'), trim(string(coalesce(triggerBody()?['fields']?['linked_issues']?['type'], ''))))}",
                            "direction": "@{if(equals(toLower(trim(string(coalesce(triggerBody()?['fields']?['linked_issues']?['direction'], '')))), 'inward'), 'inward', 'outward')}",
                            "keys": "@outputs('Compose_normalized_lists')['link_keys']"
                        }
                    },
                    "Compose_validation_errors": {
                        "runAfter": {
                            "Filter_missing_mandatory_fields": [
                                "Succeeded"
                            ],
                            "Compose_issue_links": [
                                "Succeeded"
                            ]
                        },
                        "type": "Compose",
                        "inputs": "@union(if(empty(outputs('Compose_issue_type')), array(concat('issue_type must be one of: ', join(parameters('AllowedIssueTypes'), ', '), ' (got: ', trim(string(coalesce(triggerBody()?['issue_type'], ''))), ')')), json('[]')), if(greater(length(body('Filter_missing_mandatory_fields')), 0), array(concat('missing mandatory field(s) for ', outputs('Compose_issue_type'), ': ', join(body('Filter_missing_mandatory_fields'), ', '))), json('[]')), if(and(greater(length(outputs('Compose_issue_links')['keys']), 0), empty(outputs('Compose_issue_links')['type'])), array('linked_issues.type is required when linked_issues.keys is given (or set the DefaultIssueLinkTypeName parameter)'), json('[]')))"
                    },
                    "Check_request_valid": {
                        "runAfter": {
                            "Compose_validation_errors": [
                                "Succeeded"
                            ]
                        },
                        "type": "If",
                        "expression": {
                            "equals": [
                                "@length(outputs('Compose_validation_errors'))",
                                0
                            ]
                        },
                        "actions": {},
                        "else": {
                            "actions": {
                                "Respond_400_invalid_request": {
                                    "runAfter": {},
                                    "type": "Response",
                                    "kind": "Http",
                                    "inputs": {
                                        "statusCode": 400,
                                        "headers": {
                                            "Content-Type": "application/json"
                                        },
                                        "body": {
                                            "status": "error",
                                            "ticket_key": null,
                                            "ticket_url": null,
                                            "error": "@{join(outputs('Compose_validation_errors'), '; ')}"
                                        }
                                    }
                                },
                                "Terminate_invalid_request": {
                                    "runAfter": {
                                        "Respond_400_invalid_request": [
                                            "Succeeded"
                                        ]
                                    },
                                    "type": "Terminate",
                                    "inputs": {
                                        "runStatus": "Failed",
                                        "runError": {
                                            "code": "InvalidRequest",
                                            "message": "@{join(outputs('Compose_validation_errors'), '; ')}"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "Get_Jira_password": {
                        "runAfter": {
                            "Check_request_valid": [
                                "Succeeded"
                            ]
                        },
                        "type": "ApiConnection",
                        "inputs": {
                            "host": {
                                "connection": {
                                    "name": "@parameters('$connections')['keyvault']['connectionId']"
                                }
                            },
                            "method": "get",
                            "path": "/secrets/@{encodeURIComponent(parameters('JiraKeyVaultSecretName'))}/value"
                        },
                        "runtimeConfiguration": {
                            "secureData": {
                                "properties": [
                                    "inputs",
                                    "outputs"
                                ]
                            }
                        }
                    },
                    "Filter_requested_custom_fields": {
                        "runAfter": {
                            "Check_request_valid": [
                                "Succeeded"
                            ]
                        },
                        "type": "Query",
                        "inputs": {
                            "from": "@parameters('JiraCustomFields')",
                            "where": "@not(empty(trim(string(coalesce(triggerBody()?['fields']?[item()?['key']], '')))))"
                        }
                    },
                    "Resolve_custom_field_ids": {
                        "runAfter": {
                            "Get_Jira_password": [
                                "Succeeded"
                            ],
                            "Filter_requested_custom_fields": [
                                "Succeeded"
                            ]
                        },
                        "type": "If",
                        "expression": {
                            "greater": [
                                "@length(body('Filter_requested_custom_fields'))",
                                0
                            ]
                        },
                        "actions": {
                            "Get_field_list": {
                                "runAfter": {},
                                "type": "Http",
                                "inputs": {
                                    "uri": "@{parameters('JIRAHOST')}/rest/api/2/field",
                                    "method": "GET",
                                    "headers": {
                                        "Accept": "application/json"
                                    },
                                    "authentication": {
                                        "type": "Basic",
                                        "username": "@parameters('JIRAUserName')",
                                        "password": "@body('Get_Jira_password')?['value']"
                                    }
                                },
                                "runtimeConfiguration": {
                                    "secureData": {
                                        "properties": [
                                            "inputs"
                                        ]
                                    }
                                }
                            },
                            "Foreach_requested_custom_field": {
                                "runAfter": {
                                    "Get_field_list": [
                                        "Succeeded"
                                    ]
                                },
                                "type": "Foreach",
                                "foreach": "@body('Filter_requested_custom_fields')",
                                "actions": {
                                    "Filter_field_by_name": {
                                        "runAfter": {},
                                        "type": "Query",
                                        "inputs": {
                                            "from": "@body('Get_field_list')",
                                            "where": "@and(equals(toLower(coalesce(item()?['name'], '')), toLower(coalesce(items('Foreach_requested_custom_field')?['name'], ''))), equals(coalesce(item()?['custom'], false), true))"
                                        }
                                    },
                                    "Select_matching_field_ids": {
                                        "runAfter": {
                                            "Filter_field_by_name": [
                                                "Succeeded"
                                            ]
                                        },
                                        "type": "Select",
                                        "inputs": {
                                            "from": "@body('Filter_field_by_name')",
                                            "select": "@item()?['id']"
                                        }
                                    },
                                    "Compose_resolved_field_id": {
                                        "runAfter": {
                                            "Select_matching_field_ids": [
                                                "Succeeded"
                                            ]
                                        },
                                        "type": "Compose",
                                        "inputs": "@{if(not(empty(trim(string(coalesce(items('Foreach_requested_custom_field')?['id'], ''))))), trim(string(coalesce(items('Foreach_requested_custom_field')?['id'], ''))), if(equals(length(body('Select_matching_field_ids')), 1), join(body('Select_matching_field_ids'), ''), ''))}"
                                    },
                                    "Select_checklist_items": {
                                        "runAfter": {
                                            "Compose_resolved_field_id": [
                                                "Succeeded"
                                            ]
                                        },
                                        "type": "Select",
                                        "inputs": {
                                            "from": "@if(empty(coalesce(triggerBody()?['fields']?[items('Foreach_requested_custom_field')?['key']], '')), json('[]'), if(startsWith(string(coalesce(triggerBody()?['fields']?[items('Foreach_requested_custom_field')?['key']], '')), '['), coalesce(triggerBody()?['fields']?[items('Foreach_requested_custom_field')?['key']], json('[]')), array(coalesce(triggerBody()?['fields']?[items('Foreach_requested_custom_field')?['key']], ''))))",
                                            "select": {
                                                "name": "@{item()}",
                                                "checked": false
                                            }
                                        }
                                    },
                                    "Check_field_resolved": {
                                        "runAfter": {
                                            "Select_checklist_items": [
                                                "Succeeded"
                                            ]
                                        },
                                        "type": "If",
                                        "expression": {
                                            "not": {
                                                "equals": [
                                                    "@outputs('Compose_resolved_field_id')",
                                                    ""
                                                ]
                                            }
                                        },
                                        "actions": {
                                            "Compose_merged_custom_fields": {
                                                "runAfter": {},
                                                "type": "Compose",
                                                "inputs": "@setProperty(variables('Custom_Fields'), outputs('Compose_resolved_field_id'), if(equals(toLower(coalesce(items('Foreach_requested_custom_field')?['kind'], 'text')), 'select'), addProperty(json('{}'), 'value', trim(string(coalesce(triggerBody()?['fields']?[items('Foreach_requested_custom_field')?['key']], '')))), if(equals(toLower(coalesce(items('Foreach_requested_custom_field')?['kind'], 'text')), 'insight'), array(addProperty(json('{}'), 'key', trim(string(coalesce(triggerBody()?['fields']?[items('Foreach_requested_custom_field')?['key']], ''))))), if(equals(toLower(coalesce(items('Foreach_requested_custom_field')?['kind'], 'text')), 'checklist'), body('Select_checklist_items'), if(equals(toLower(coalesce(items('Foreach_requested_custom_field')?['kind'], 'text')), 'text'), string(coalesce(triggerBody()?['fields']?[items('Foreach_requested_custom_field')?['key']], '')), coalesce(triggerBody()?['fields']?[items('Foreach_requested_custom_field')?['key']], ''))))))"
                                            },
                                            "Set_Custom_Fields": {
                                                "runAfter": {
                                                    "Compose_merged_custom_fields": [
                                                        "Succeeded"
                                                    ]
                                                },
                                                "type": "SetVariable",
                                                "inputs": {
                                                    "name": "Custom_Fields",
                                                    "value": "@outputs('Compose_merged_custom_fields')"
                                                }
                                            }
                                        },
                                        "else": {
                                            "actions": {
                                                "Append_unresolved_field": {
                                                    "runAfter": {},
                                                    "type": "AppendToArrayVariable",
                                                    "inputs": {
                                                        "name": "Unresolved_Fields",
                                                        "value": "@{items('Foreach_requested_custom_field')?['key']} (Jira field named '@{items('Foreach_requested_custom_field')?['name']}': @{length(body('Select_matching_field_ids'))} custom field(s) with that name in /rest/api/2/field)"
                                                    }
                                                }
                                            }
                                        }
                                    }
                                },
                                "runtimeConfiguration": {
                                    "concurrency": {
                                        "repetitions": 1
                                    }
                                }
                            },
                            "Check_unresolved_fields": {
                                "runAfter": {
                                    "Foreach_requested_custom_field": [
                                        "Succeeded"
                                    ]
                                },
                                "type": "If",
                                "expression": {
                                    "greater": [
                                        "@length(variables('Unresolved_Fields'))",
                                        0
                                    ]
                                },
                                "actions": {
                                    "Respond_500_unresolved_fields": {
                                        "runAfter": {},
                                        "type": "Response",
                                        "kind": "Http",
                                        "inputs": {
                                            "statusCode": 500,
                                            "headers": {
                                                "Content-Type": "application/json"
                                            },
                                            "body": {
                                                "status": "error",
                                                "ticket_key": null,
                                                "ticket_url": null,
                                                "error": "@{concat('request field(s) could not be mapped to a Jira custom field id: ', join(variables('Unresolved_Fields'), '; '), '. Pin the id in the JiraCustomFields parameter of the playbook.')}"
                                            }
                                        }
                                    },
                                    "Terminate_unresolved_fields": {
                                        "runAfter": {
                                            "Respond_500_unresolved_fields": [
                                                "Succeeded"
                                            ]
                                        },
                                        "type": "Terminate",
                                        "inputs": {
                                            "runStatus": "Failed",
                                            "runError": {
                                                "code": "UnresolvedCustomField",
                                                "message": "@{join(variables('Unresolved_Fields'), '; ')}"
                                            }
                                        }
                                    }
                                },
                                "else": {
                                    "actions": {}
                                }
                            }
                        },
                        "else": {
                            "actions": {}
                        }
                    },
                    "Compose_resolved_defaults": {
                        "runAfter": {
                            "Check_request_valid": [
                                "Succeeded"
                            ]
                        },
                        "type": "Compose",
                        "inputs": {
                            "priority": "@{if(empty(trim(string(coalesce(triggerBody()?['fields']?['priority'], '')))), coalesce(parameters('DefaultPriorityByType')?[if(empty(outputs('Compose_issue_type')), '-', outputs('Compose_issue_type'))], ''), trim(string(coalesce(triggerBody()?['fields']?['priority'], ''))))}",
                            "assignee": "@{if(empty(trim(string(coalesce(triggerBody()?['fields']?['assignee'], '')))), parameters('DefaultAssigneeName'), trim(string(coalesce(triggerBody()?['fields']?['assignee'], ''))))}",
                            "security_level": "@{if(empty(trim(string(coalesce(triggerBody()?['fields']?['security_level'], '')))), parameters('DefaultSecurityLevelName'), trim(string(coalesce(triggerBody()?['fields']?['security_level'], ''))))}"
                        }
                    },
                    "Select_components": {
                        "runAfter": {
                            "Check_request_valid": [
                                "Succeeded"
                            ]
                        },
                        "type": "Select",
                        "inputs": {
                            "from": "@outputs('Compose_normalized_lists')['components']",
                            "select": {
                                "name": "@{item()}"
                            }
                        }
                    },
                    "Select_issue_links": {
                        "runAfter": {
                            "Check_request_valid": [
                                "Succeeded"
                            ]
                        },
                        "type": "Select",
                        "inputs": {
                            "from": "@outputs('Compose_issue_links')['keys']",
                            "select": "@addProperty(json('{}'), 'add', addProperty(addProperty(json('{}'), 'type', addProperty(json('{}'), 'name', outputs('Compose_issue_links')['type'])), if(equals(outputs('Compose_issue_links')['direction'], 'inward'), 'inwardIssue', 'outwardIssue'), addProperty(json('{}'), 'key', trim(string(item())))))"
                        }
                    },
                    "Build_core_fields": {
                        "runAfter": {
                            "Compose_resolved_defaults": [
                                "Succeeded"
                            ]
                        },
                        "type": "Compose",
                        "inputs": {
                            "project": {
                                "key": "@{parameters('JiraProjectKey')}"
                            },
                            "issuetype": {
                                "name": "@{outputs('Compose_issue_type')}"
                            },
                            "summary": "@{trim(string(coalesce(triggerBody()?['fields']?['summary'], '')))}"
                        }
                    },
                    "Build_optional_fields": {
                        "runAfter": {
                            "Build_core_fields": [
                                "Succeeded"
                            ],
                            "Select_components": [
                                "Succeeded"
                            ]
                        },
                        "type": "Compose",
                        "inputs": "@union(json('{}'), if(empty(outputs('Compose_resolved_defaults')?['priority']), json('{}'), addProperty(json('{}'), 'priority', addProperty(json('{}'), if(isInt(outputs('Compose_resolved_defaults')?['priority']), 'id', 'name'), outputs('Compose_resolved_defaults')?['priority']))), if(empty(trim(string(coalesce(triggerBody()?['fields']?['description'], '')))), json('{}'), addProperty(json('{}'), 'description', string(coalesce(triggerBody()?['fields']?['description'], '')))), if(empty(outputs('Compose_resolved_defaults')?['security_level']), json('{}'), addProperty(json('{}'), 'security', addProperty(json('{}'), 'name', outputs('Compose_resolved_defaults')?['security_level']))), if(empty(trim(string(coalesce(triggerBody()?['fields']?['reporter'], '')))), json('{}'), addProperty(json('{}'), 'reporter', addProperty(json('{}'), 'name', trim(string(coalesce(triggerBody()?['fields']?['reporter'], '')))))), if(empty(outputs('Compose_resolved_defaults')?['assignee']), json('{}'), addProperty(json('{}'), 'assignee', addProperty(json('{}'), 'name', outputs('Compose_resolved_defaults')?['assignee']))), if(equals(length(body('Select_components')), 0), json('{}'), addProperty(json('{}'), 'components', body('Select_components'))), if(equals(length(outputs('Compose_normalized_lists')['labels']), 0), json('{}'), addProperty(json('{}'), 'labels', outputs('Compose_normalized_lists')['labels'])), if(empty(trim(string(coalesce(triggerBody()?['fields']?['due_date'], '')))), json('{}'), addProperty(json('{}'), 'duedate', trim(string(coalesce(triggerBody()?['fields']?['due_date'], ''))))))"
                    },
                    "Compose_issue_body": {
                        "runAfter": {
                            "Build_optional_fields": [
                                "Succeeded"
                            ],
                            "Select_issue_links": [
                                "Succeeded"
                            ],
                            "Resolve_custom_field_ids": [
                                "Succeeded"
                            ]
                        },
                        "type": "Compose",
                        "inputs": "@union(addProperty(json('{}'), 'fields', union(outputs('Build_core_fields'), outputs('Build_optional_fields'), variables('Custom_Fields'))), if(greater(length(body('Select_issue_links')), 0), addProperty(json('{}'), 'update', addProperty(json('{}'), 'issuelinks', body('Select_issue_links'))), json('{}')))"
                    }
                }
            },
            "Create_issue": {
                "runAfter": {
                    "Prepare": [
                        "Succeeded"
                    ]
                },
                "type": "Http",
                "inputs": {
                    "uri": "@{parameters('JIRAHOST')}/rest/api/2/issue",
                    "method": "POST",
                    "headers": {
                        "Content-Type": "application/json",
                        "Accept": "application/json"
                    },
                    "body": "@outputs('Compose_issue_body')",
                    "authentication": {
                        "type": "Basic",
                        "username": "@parameters('JIRAUserName')",
                        "password": "@body('Get_Jira_password')?['value']"
                    },
                    "retryPolicy": {
                        "type": "none"
                    }
                },
                "runtimeConfiguration": {
                    "secureData": {
                        "properties": [
                            "inputs"
                        ]
                    }
                }
            },
            "Parse_create_response": {
                "runAfter": {
                    "Create_issue": [
                        "Succeeded"
                    ]
                },
                "type": "ParseJson",
                "inputs": {
                    "content": "@body('Create_issue')",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "id": {
                                "type": "string"
                            },
                            "key": {
                                "type": "string"
                            },
                            "self": {
                                "type": "string"
                            }
                        }
                    }
                }
            },
            "Set_Ticket_Key": {
                "runAfter": {
                    "Parse_create_response": [
                        "Succeeded"
                    ]
                },
                "type": "SetVariable",
                "inputs": {
                    "name": "Ticket_Key",
                    "value": "@{body('Parse_create_response')?['key']}"
                }
            },
            "Respond_ticket_created": {
                "runAfter": {
                    "Set_Ticket_Key": [
                        "Succeeded"
                    ]
                },
                "type": "Response",
                "kind": "Http",
                "inputs": {
                    "statusCode": 200,
                    "headers": {
                        "Content-Type": "application/json"
                    },
                    "body": {
                        "status": "ok",
                        "ticket_key": "@{variables('Ticket_Key')}",
                        "ticket_url": "@{parameters('JIRAHOST')}/browse/@{variables('Ticket_Key')}",
                        "error": null
                    }
                }
            },
            "Handle_create_failure": {
                "runAfter": {
                    "Create_issue": [
                        "Failed",
                        "TimedOut"
                    ]
                },
                "type": "Scope",
                "actions": {
                    "Compose_create_error": {
                        "runAfter": {},
                        "type": "Compose",
                        "inputs": "@{concat('Jira did not create the issue (HTTP ', string(coalesce(outputs('Create_issue')?['statusCode'], 502)), '): ', substring(string(coalesce(body('Create_issue'), '')), 0, min(length(string(coalesce(body('Create_issue'), ''))), 1000)))}"
                    },
                    "Respond_create_failed": {
                        "runAfter": {
                            "Compose_create_error": [
                                "Succeeded"
                            ]
                        },
                        "type": "Response",
                        "kind": "Http",
                        "inputs": {
                            "statusCode": "@if(and(greaterOrEquals(coalesce(outputs('Create_issue')?['statusCode'], 502), 400), less(coalesce(outputs('Create_issue')?['statusCode'], 502), 600)), coalesce(outputs('Create_issue')?['statusCode'], 502), 502)",
                            "headers": {
                                "Content-Type": "application/json"
                            },
                            "body": {
                                "status": "error",
                                "ticket_key": null,
                                "ticket_url": null,
                                "error": "@{outputs('Compose_create_error')}"
                            }
                        }
                    },
                    "Terminate_create_failed": {
                        "runAfter": {
                            "Respond_create_failed": [
                                "Succeeded"
                            ]
                        },
                        "type": "Terminate",
                        "inputs": {
                            "runStatus": "Failed",
                            "runError": {
                                "code": "JiraCreateFailed",
                                "message": "@{outputs('Compose_create_error')}"
                            }
                        }
                    }
                }
            },
            "Handle_prepare_failure": {
                "runAfter": {
                    "Prepare": [
                        "Failed",
                        "TimedOut"
                    ]
                },
                "type": "Scope",
                "actions": {
                    "Filter_failed_prepare_actions": {
                        "runAfter": {},
                        "type": "Query",
                        "inputs": {
                            "from": "@result('Prepare')",
                            "where": "@or(equals(item()?['status'], 'Failed'), equals(item()?['status'], 'TimedOut'))"
                        }
                    },
                    "Select_failure_messages": {
                        "runAfter": {
                            "Filter_failed_prepare_actions": [
                                "Succeeded"
                            ]
                        },
                        "type": "Select",
                        "inputs": {
                            "from": "@body('Filter_failed_prepare_actions')",
                            "select": "@{item()?['name']}: @{coalesce(item()?['error']?['message'], item()?['status'])}"
                        }
                    },
                    "Respond_prepare_failed": {
                        "runAfter": {
                            "Select_failure_messages": [
                                "Succeeded"
                            ]
                        },
                        "type": "Response",
                        "kind": "Http",
                        "inputs": {
                            "statusCode": 500,
                            "headers": {
                                "Content-Type": "application/json"
                            },
                            "body": {
                                "status": "error",
                                "ticket_key": null,
                                "ticket_url": null,
                                "error": "@{concat('the playbook failed before the ticket could be created: ', join(body('Select_failure_messages'), '; '))}"
                            }
                        }
                    },
                    "Terminate_prepare_failed": {
                        "runAfter": {
                            "Respond_prepare_failed": [
                                "Succeeded"
                            ]
                        },
                        "type": "Terminate",
                        "inputs": {
                            "runStatus": "Failed",
                            "runError": {
                                "code": "PrepareFailed",
                                "message": "@{join(body('Select_failure_messages'), '; ')}"
                            }
                        }
                    }
                }
            }
        },
        "outputs": {}
    },
    "parameters": {
        "$connections": {
            "value": {
                "keyvault": {
                    "id": "/subscriptions/f12b729d-7c1e-4407-bb9d-2e7ec4aa1d29/providers/Microsoft.Web/locations/westeurope/managedApis/keyvault",
                    "connectionId": "/subscriptions/f12b729d-7c1e-4407-bb9d-2e7ec4aa1d29/resourceGroups/LSY_WEUR_ITCS_PRD_SEC_RG_002/providers/Microsoft.Web/connections/keyvault-CLOPSSEC_ticket_creation",
                    "connectionName": "keyvault-CLOPSSEC_ticket_creation",
                    "connectionProperties": {
                        "authentication": {
                            "type": "ManagedServiceIdentity"
                        }
                    }
                }
            }
        }
    }
}
