                    "target": "@{outputs('Compose_targets')?['blob_append']}",
                    "http_status": "@coalesce(outputs('Call_blob_append')?['statusCode'], 0)",
                    "outcome": "@{if(and(and(equals(coalesce(outputs('Call_blob_append')?['statusCode'], 0), 200), equals(string(coalesce(outputs('Compose_blob_json')?['status'], '')), 'ok')), or(equals(outputs('Compose_blob_expected'), -1), equals(coalesce(outputs('Compose_blob_json')?['appended_count'], -3), outputs('Compose_blob_expected')))), 'pass', 'fail')}",
                    "blob_url": "@{trim(string(coalesce(outputs('Compose_blob_json')?['blob_url'], '')))}",
                    "requested_count": "@coalesce(outputs('Compose_blob_json')?['requested_count'], 0)",
                    "distinct_count": "@coalesce(outputs('Compose_blob_json')?['distinct_count'], 0)",
                    "appended_count": "@coalesce(outputs('Compose_blob_json')?['appended_count'], 0)",
                    "skipped_duplicate_count": "@coalesce(outputs('Compose_blob_json')?['skipped_duplicate_count'], 0)",
                    "blob_created": "@coalesce(outputs('Compose_blob_json')?['blob_created'], false)",
                    "attempts": "@coalesce(outputs('Compose_blob_json')?['attempts'], 0)",
                    "upstream_status_code": "@coalesce(outputs('Compose_blob_json')?['upstream_status_code'], 0)",
                    "error_code": "@if(empty(trim(string(coalesce(outputs('Compose_blob_json')?['error_code'], '')))), null, trim(string(coalesce(outputs('Compose_blob_json')?['error_code'], ''))))",
                    "error": "@if(empty(trim(string(coalesce(outputs('Compose_blob_json')?['error'], '')))), null, trim(string(coalesce(outputs('Compose_blob_json')?['error'], ''))))",
                    "expected_appended": "@if(equals(outputs('Compose_blob_expected'), -1), null, outputs('Compose_blob_expected'))"
                }
            },
            "Append_blob_step": {
                "runAfter": {
                    "Compose_blob_result": [
                        "Succeeded"
                    ]
                },
                "type": "AppendToArrayVariable",
                "inputs": {
                    "name": "Steps",
                    "value": "@outputs('Compose_blob_result')"
                }
            },
            "Set_Error_from_blob": {
                "runAfter": {
                    "Append_blob_step": [
                        "Succeeded"
                    ]
                },
                "type": "SetVariable",
                "inputs": {
                    "name": "Error",
                    "value": "@{if(and(equals(outputs('Compose_blob_result')?['outcome'], 'fail'), empty(variables('Error'))), concat('blob_append: ', coalesce(outputs('Compose_blob_result')?['error'], concat('HTTP ', string(outputs('Compose_blob_result')?['http_status'])))), variables('Error'))}"
                }
            },
            "Run_blob_dedupe_step": {
                "runAfter": {
                    "Set_Error_from_blob": [
                        "Succeeded"
                    ]
                },
                "type": "If",
                "expression": {
                    "equals": [
                        "@and(and(parameters('BlobAppendVerifyDedupe'), equals(outputs('Compose_blob_result')?['outcome'], 'pass')), not(equals(toLower(string(coalesce(outputs('Compose_blob_request')?['dry_run'], false))), 'true')))",
                        true
                    ]
                },
                "actions": {
                    "Compose_blob_dedupe_request": {
                        "runAfter": {},
                        "type": "Compose",
                        "inputs": "@setProperty(outputs('Compose_blob_request'), 'skip_duplicates', true)"
                    },
                    "Call_blob_append_dedupe": {
                        "type": "Http",
                        "inputs": {
                            "uri": "@{if(empty(trim(string(coalesce(triggerBody()?['targets']?['blob_append_url'], '')))), parameters('BlobAppendCallbackUrl'), trim(string(coalesce(triggerBody()?['targets']?['blob_append_url'], ''))))}",
                            "method": "POST",
                            "headers": {
                                "Content-Type": "application/json"
                            },
                            "body": "@outputs('Compose_blob_dedupe_request')",
                            "retryPolicy": {
                                "type": "none"
                            }
                        },
                        "operationOptions": "DisableAsyncPattern",
                        "runtimeConfiguration": {
                            "secureData": {
                                "properties": [
                                    "inputs"
                                ]
                            }
                        },
                        "runAfter": {
                            "Compose_blob_dedupe_request": [
                                "Succeeded"
                            ]
                        }
                    },
                    "Compose_dedupe_raw": {
                        "runAfter": {
                            "Call_blob_append_dedupe": [
                                "Succeeded",
                                "Failed",
                                "TimedOut"
                            ]
                        },
                        "type": "Compose",
                        "inputs": "@{string(coalesce(body('Call_blob_append_dedupe'), ''))}"
                    },
                    "Compose_dedupe_json": {
                        "runAfter": {
                            "Compose_dedupe_raw": [
                                "Succeeded"
                            ]
                        },
                        "type": "Compose",
                        "inputs": "@json(if(startsWith(trim(outputs('Compose_dedupe_raw')), '{'), outputs('Compose_dedupe_raw'), '{}'))"
                    },
                    "Compose_dedupe_result": {
                        "runAfter": {
                            "Compose_dedupe_json": [
                                "Succeeded"
                            ]
                        },
                        "type": "Compose",
                        "inputs": {
                            "name": "blob_append_dedupe",
                            "target": "@{outputs('Compose_targets')?['blob_append']}",
                            "http_status": "@coalesce(outputs('Call_blob_append_dedupe')?['statusCode'], 0)",
                            "outcome": "@{if(and(and(equals(coalesce(outputs('Call_blob_append_dedupe')?['statusCode'], 0), 200), equals(string(coalesce(outputs('Compose_dedupe_json')?['status'], '')), 'ok')), and(equals(coalesce(outputs('Compose_dedupe_json')?['appended_count'], -1), 0), equals(coalesce(outputs('Compose_dedupe_json')?['skipped_duplicate_count'], -1), coalesce(outputs('Compose_dedupe_json')?['requested_count'], -2)))), 'pass', 'fail')}",
                            "blob_url": "@{trim(string(coalesce(outputs('Compose_dedupe_json')?['blob_url'], '')))}",
                            "requested_count": "@coalesce(outputs('Compose_dedupe_json')?['requested_count'], 0)",
                            "distinct_count": "@coalesce(outputs('Compose_dedupe_json')?['distinct_count'], 0)",
                            "appended_count": "@coalesce(outputs('Compose_dedupe_json')?['appended_count'], 0)",
                            "skipped_duplicate_count": "@coalesce(outputs('Compose_dedupe_json')?['skipped_duplicate_count'], 0)",
                            "blob_created": "@coalesce(outputs('Compose_dedupe_json')?['blob_created'], false)",
                            "attempts": "@coalesce(outputs('Compose_dedupe_json')?['attempts'], 0)",
                            "upstream_status_code": "@coalesce(outputs('Compose_dedupe_json')?['upstream_status_code'], 0)",
                            "error_code": "@if(empty(trim(string(coalesce(outputs('Compose_dedupe_json')?['error_code'], '')))), null, trim(string(coalesce(outputs('Compose_dedupe_json')?['error_code'], ''))))",
                            "error": "@if(empty(trim(string(coalesce(outputs('Compose_dedupe_json')?['error'], '')))), null, trim(string(coalesce(outputs('Compose_dedupe_json')?['error'], ''))))",
                            "expected_appended": "@0"
                        }
                    },
                    "Append_dedupe_step": {
                        "runAfter": {
                            "Compose_dedupe_result": [
                                "Succeeded"
                            ]
                        },
                        "type": "AppendToArrayVariable",
                        "inputs": {
                            "name": "Steps",
                            "value": "@outputs('Compose_dedupe_result')"
                        }
                    },
                    "Set_Error_from_dedupe": {
                        "runAfter": {
                            "Append_dedupe_step": [
                                "Succeeded"
                            ]
                        },
                        "type": "SetVariable",
                        "inputs": {
                            "name": "Error",
                            "value": "@{if(and(equals(outputs('Compose_dedupe_result')?['outcome'], 'fail'), empty(variables('Error'))), concat('blob_append_dedupe: ', coalesce(outputs('Compose_dedupe_result')?['error'], concat('HTTP ', string(outputs('Compose_dedupe_result')?['http_status'])))), variables('Error'))}"
                        }
                    }
                },
                "else": {
                    "actions": {}
                }
            },
            "Filter_Failed_Steps": {
                "runAfter": {
                    "Run_blob_dedupe_step": [
                        "Succeeded"
                    ]
                },
                "type": "Query",
                "inputs": {
                    "from": "@variables('Steps')",
                    "where": "@equals(item()?['outcome'], 'fail')"
                }
            },
            "Compose_report": {
                "runAfter": {
                    "Filter_Failed_Steps": [
                        "Succeeded"
                    ]
                },
                "type": "Compose",
                "inputs": {
                    "status": "@{if(equals(length(body('Filter_Failed_Steps')), 0), 'pass', 'fail')}",
                    "ts": "@{utcNow()}",
                    "playbook": "@{workflow().name}",
                    "run_id": "@{workflow().run.name}",
                    "issue_type": "@{outputs('Compose_request')?['issue_type']}",
                    "summary": "@{outputs('Compose_request')?['summary']}",
                    "steps": "@variables('Steps')",
                    "parent_ticket_key": "@if(empty(variables('Parent_Key')), null, variables('Parent_Key'))",
                    "parent_ticket_url": "@if(empty(variables('Parent_Key')), null, concat(parameters('JIRAHOST'), '/browse/', variables('Parent_Key')))",
                    "subtask_key": "@if(empty(variables('Subtask_Key')), null, variables('Subtask_Key'))",
                    "subtask_url": "@if(empty(variables('Subtask_Key')), null, concat(parameters('JIRAHOST'), '/browse/', variables('Subtask_Key')))",
                    "blob_url": "@if(empty(trim(string(coalesce(outputs('Compose_blob_json')?['blob_url'], '')))), null, trim(string(coalesce(outputs('Compose_blob_json')?['blob_url'], ''))))",
                    "blob_appended_count": "@coalesce(outputs('Compose_blob_json')?['appended_count'], 0)",
                    "error": "@if(empty(variables('Error')), null, variables('Error'))",
                    "ledger_blob": "https://@{parameters('StorageAccountName')}.blob.core.windows.net/@{parameters('LedgerContainer')}/@{parameters('LedgerBlobPath')}"
                }
            },
            "Ensure_ledger_blob": {
                "runAfter": {
                    "Compose_report": [
                        "Succeeded"
                    ]
                },
                "type": "Http",
                "inputs": {
                    "uri": "https://@{parameters('StorageAccountName')}.blob.core.windows.net/@{parameters('LedgerContainer')}/@{parameters('LedgerBlobPath')}",
                    "method": "PUT",
                    "headers": {
                        "x-ms-version": "2021-08-06",
                        "x-ms-blob-type": "AppendBlob",
                        "If-None-Match": "*",
                        "Content-Length": "0"
                    },
                    "authentication": {
                        "type": "ManagedServiceIdentity",
                        "audience": "https://storage.azure.com/"
                    },
                    "retryPolicy": {
                        "type": "none"
                    }
                }
            },
            "Append_ledger_line": {
                "runAfter": {
                    "Ensure_ledger_blob": [
                        "Succeeded",
                        "Failed"
                    ]
                },
                "type": "Http",
                "inputs": {
                    "uri": "https://@{parameters('StorageAccountName')}.blob.core.windows.net/@{parameters('LedgerContainer')}/@{parameters('LedgerBlobPath')}?comp=appendblock",
                    "method": "PUT",
                    "headers": {
                        "x-ms-version": "2021-08-06",
                        "Content-Type": "application/json"
                    },
                    "body": "@{string(outputs('Compose_report'))}\n",
                    "authentication": {
                        "type": "ManagedServiceIdentity",
                        "audience": "https://storage.azure.com/"
                    }
                }
            },
            "Set_Ledger_Status_ok": {
                "runAfter": {
                    "Append_ledger_line": [
                        "Succeeded"
                    ]
                },
                "type": "SetVariable",
                "inputs": {
                    "name": "Ledger_Status",
                    "value": "written"
                }
            },
            "Set_Ledger_Status_failed": {
                "runAfter": {
                    "Append_ledger_line": [
                        "Failed",
                        "TimedOut"
                    ]
                },
                "type": "SetVariable",
                "inputs": {
                    "name": "Ledger_Status",
                    "value": "@{concat('failed (HTTP ', string(coalesce(outputs('Append_ledger_line')?['statusCode'], 502)), '): ', substring(string(coalesce(body('Append_ledger_line'), '')), 0, min(length(string(coalesce(body('Append_ledger_line'), ''))), 500)))}"
                }
            },
            "Respond_result": {
                "runAfter": {
                    "Set_Ledger_Status_ok": [
                        "Succeeded",
                        "Skipped"
                    ],
                    "Set_Ledger_Status_failed": [
                        "Succeeded",
                        "Skipped"
                    ]
                },
                "type": "Response",
                "kind": "Http",
                "inputs": {
                    "statusCode": "@if(equals(outputs('Compose_report')?['status'], 'pass'), 200, 502)",
                    "headers": {
                        "Content-Type": "application/json"
                    },
                    "body": "@setProperty(outputs('Compose_report'), 'ledger', variables('Ledger_Status'))"
                }
            },
            "Terminate_if_failed": {
                "runAfter": {
                    "Respond_result": [
                        "Succeeded"
                    ]
                },
                "type": "If",
                "expression": {
                    "or": [
                        {
                            "not": {
                                "equals": [
                                    "@outputs('Compose_report')?['status']",
                                    "pass"
                                ]
                            }
                        },
                        {
                            "not": {
                                "equals": [
                                    "@variables('Ledger_Status')",
                                    "written"
                                ]
                            }
                        }
                    ]
                },
                "actions": {
                    "Terminate_failed": {
                        "runAfter": {},
                        "type": "Terminate",
                        "inputs": {
                            "runStatus": "Failed",
                            "runError": {
                                "code": "BuildingBlockTestFailed",
                                "message": "@{concat('status=', outputs('Compose_report')?['status'], '; ledger=', variables('Ledger_Status'), '; error=', coalesce(variables('Error'), ''))}"
                            }
                        }
                    }
                },
                "else": {
                    "actions": {}
                }
            }
        },
        "outputs": {}
    },
    "parameters": {}
}
