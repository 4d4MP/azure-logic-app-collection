{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "PlaybookName": {
            "value": "dev_tool"
        },
        "Location": {
            "value": "westeurope"
        },
        "TicketCreationPlaybookName": {
            "value": "CLOPSSEC_ticket_creation"
        },
        "SubtaskPlaybookName": {
            "value": "create_subtask"
        },
        "TicketTransitionPlaybookName": {
            "value": "CLOPSSEC_ticket_transition"
        },
        "JIRAHOST": {
            "value": "https://trackspace.lhsystems.com"
        },
        "DefaultIssueType": {
            "value": "Incident"
        },
        "DefaultPriority": {
            "value": "10114"
        },
        "DefaultSummary": {
            "value": "[dev_tool] building-block orchestration test"
        },
        "DefaultDescription": {
            "value": "Automated test ticket raised by the dev_tool Logic App to validate the CLOPSSEC_ticket_creation -> create_subtask building-block chain. Safe to close."
        },
        "DefaultSubtaskSummary": {
            "value": "[dev_tool] subtask orchestration test"
        },
        "DefaultSubtaskDescription": {
            "value": "Automated subtask raised by the dev_tool Logic App under the parent test ticket. Safe to close."
        },
        "CloseTickets": {
            "value": true
        },
        "ClosePath": {
            "value": [
                "In Progress",
                "Resolved",
                "Closed"
            ]
        },
        "TransitionFieldValues": {
            "value": {}
        },
        "CloseStageBudgetSeconds": {
            "value": 90
        }
    }
}
